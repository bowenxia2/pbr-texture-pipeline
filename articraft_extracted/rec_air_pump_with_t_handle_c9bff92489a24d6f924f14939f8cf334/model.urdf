  <joint name="body_to_handle" type="prismatic">
    <origin xyz="0 0 0.504" rpy="0 0 0" />
    <parent link="body" />
    <child link="handle" />
    <axis xyz="0 0 1" />
    <limit effort="180" velocity="0.8" lower="-0.14" upper="0.06" />
    </joint>
  <joint name="body_to_stabilizer_bar" type="prismatic">
    <origin xyz="0 0 0.019" rpy="0 0 0" />
    <parent link="body" />
    <child link="stabilizer_bar" />
    <axis xyz="1 0 0" />
    <limit effort="50" velocity="0.25" lower="0" upper="0.1" />
    </joint>
  <joint name="body_to_gauge" type="fixed">
    <origin xyz="0 0.0245 0.068" rpy="0 0 0" />
    <parent link="body" />
    <child link="gauge" />
    </joint>
  <joint name="gauge_to_release_button" type="prismatic">
    <origin xyz="0.02 0.047 0.018" rpy="0 0 0" />
