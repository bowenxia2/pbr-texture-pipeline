<robot name="minimalist_all_in_one_printer">
  <material name="body_finish">
    <color rgba="0.94 0.95 0.96 1" />
    </material>
  <material name="lid_finish">
    <color rgba="0.9 0.91 0.93 1" />
    </material>
  <material name="tray_finish">
    <color rgba="0.26 0.28 0.3 1" />
    </material>
  <material name="control_finish">
    <color rgba="0.13 0.14 0.15 1" />
    </material>
  <link name="body">
    <visual name="body_shell">
      <geometry>
        <mesh filename="assets/meshes/printer_body.obj" />
        </geometry>
      <material name="body_finish">
        <color rgba="0.94 0.95 0.96 1" />
        </material>
      </visual>
    <collision name="body_shell">
      <geometry>
        <mesh filename="assets/meshes/printer_body.obj" />
        </geometry>
      </collision>
    </link>
  <link name="lid">
    <visual name="lid_shell">
      <geometry>
        <mesh filename="assets/meshes/scanner_lid.obj" />
        </geometry>
      <material name="lid_finish">
        <color rgba="0.9 0.91 0.93 1" />
        </material>
      </visual>
    <collision name="lid_shell">
      <geometry>
        <mesh filename="assets/meshes/scanner_lid.obj" />
        </geometry>
      </collision>
    </link>
  <link name="tray">
    <visual name="tray_shell">
      <geometry>
        <mesh filename="assets/meshes/paper_tray.obj" />
        </geometry>
      <material name="tray_finish">
        <color rgba="0.26 0.28 0.3 1" />
        </material>
      </visual>
    <collision name="tray_shell">
      <geometry>
        <mesh filename="assets/meshes/paper_tray.obj" />
        </geometry>
      </collision>
    </link>
  <link name="feeder">
    <visual name="feeder_panel">
      <geometry>
        <mesh filename="assets/meshes/rear_feeder.obj" />
        </geometry>
      <material name="lid_finish">
        <color rgba="0.9 0.91 0.93 1" />
        </material>
      </visual>
    <collision name="feeder_panel">
      <geometry>
        <mesh filename="assets/meshes/rear_feeder.obj" />
        </geometry>
      </collision>
    </link>
  <link name="selector_knob">
    <visual name="knob_cap">
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <mesh filename="assets/meshes/selector_knob.obj" />
        </geometry>
      <material name="control_finish">
        <color rgba="0.13 0.14 0.15 1" />
        </material>
      </visual>
    <collision name="knob_cap">
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <mesh filename="assets/meshes/selector_knob.obj" />
        </geometry>
      </collision>
    </link>
  <link name="button_0">
    <visual name="button_cap">
      <origin xyz="0 -0.003 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.009" length="0.006" />
        </geometry>
      <material name="control_finish">
        <color rgba="0.13 0.14 0.15 1" />
        </material>
      </visual>
    <collision name="button_cap">
      <origin xyz="0 -0.003 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.009" length="0.006" />
        </geometry>
      </collision>
    </link>
  <link name="button_1">
    <visual name="button_cap">
      <origin xyz="0 -0.003 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.009" length="0.006" />
        </geometry>
      <material name="control_finish">
        <color rgba="0.13 0.14 0.15 1" />
        </material>
      </visual>
    <collision name="button_cap">
      <origin xyz="0 -0.003 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.009" length="0.006" />
        </geometry>
      </collision>
    </link>
  <joint name="body_to_lid" type="revolute">
    <origin xyz="0 0.146 0.215" rpy="0 0 0" />
    <parent link="body" />
    <child link="lid" />
    <axis xyz="-1 0 0" />
    <limit effort="8" velocity="1.8" lower="0" upper="1.25" />
    </joint>
  <joint name="body_to_tray" type="prismatic">
    <origin xyz="0 -0.172 0.018" rpy="0 0 0" />
    <parent link="body" />
    <child link="tray" />
    <axis xyz="0 -1 0" />
    <limit effort="25" velocity="0.18" lower="0" upper="0.12" />
    </joint>
  <joint name="body_to_feeder" type="revolute">
    <origin xyz="0 0.16 0.215" rpy="0 0 0" />
    <parent link="body" />
    <child link="feeder" />
    <axis xyz="1 0 0" />
    <limit effort="5" velocity="1.8" lower="0" upper="1.3" />
    </joint>
  <joint name="body_to_selector_knob" type="continuous">
    <origin xyz="0.098 -0.17 0.136" rpy="0 0 0" />
    <parent link="body" />
    <child link="selector_knob" />
    <axis xyz="0 1 0" />
    <limit effort="1.5" velocity="5" />
    </joint>
  <joint name="body_to_button_0" type="prismatic">
    <origin xyz="0.052 -0.17 0.145" rpy="0 0 0" />
    <parent link="body" />
    <child link="button_0" />
    <axis xyz="0 1 0" />
    <limit effort="2" velocity="0.08" lower="0" upper="0.003" />
    </joint>
  <joint name="body_to_button_1" type="prismatic">
    <origin xyz="0.052 -0.17 0.119" rpy="0 0 0" />
    <parent link="body" />
    <child link="button_1" />
    <axis xyz="0 1 0" />
    <limit effort="2" velocity="0.08" lower="0" upper="0.003" />
    </joint>
  </robot>
