    </link>
  <joint name="body_to_plunger" type="prismatic">
    <origin xyz="0 0 1.055" rpy="0 0 0" />
    <parent link="pump_body" />
    <child link="plunger" />
    <axis xyz="0 0 1" />
    <limit effort="90" velocity="0.45" lower="0" upper="0.28" />
    </joint>
  <joint name="body_to_selector_knob" type="revolute">
    <origin xyz="0.06 -0.177 0.655" rpy="1.5708 0 0" />
    <parent link="pump_body" />
    <child link="selector_knob" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="5" lower="-3.14159" upper="3.14159" />
    </joint>
  </robot>
