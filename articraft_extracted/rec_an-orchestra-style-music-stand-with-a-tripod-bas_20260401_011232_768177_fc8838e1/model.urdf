    <child link="upper_pole" />
    <axis xyz="0 0 1" />
    <limit effort="60" velocity="0.15" lower="0" upper="0.3" />
    </joint>
  <joint name="upper_pole_to_desk" type="fixed">
    <origin xyz="0 0 0.68" rpy="0 0 0" />
