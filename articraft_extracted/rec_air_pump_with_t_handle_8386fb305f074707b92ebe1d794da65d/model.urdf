  <joint name="body_to_handle" type="prismatic">
    <origin xyz="0 0 0.7" rpy="0 0 0" />
    <parent link="body" />
    <child link="handle" />
    <axis xyz="0 0 1" />
    <limit effort="140" velocity="0.6" lower="0" upper="0.2" />
    </joint>
  <joint name="body_to_stabilizer" type="prismatic">
    <origin xyz="0 0 0.025" rpy="0 0 0" />
    <parent link="body" />
    <child link="stabilizer" />
    <axis xyz="1 0 0" />
    <limit effort="60" velocity="0.3" lower="-0.08" upper="0.08" />
    </joint>
  <joint name="handle_to_grip" type="continuous">
    <origin xyz="0 0 0.34" rpy="0 0 0" />
    <parent link="handle" />
    <child link="grip" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="8" />
    </joint>
