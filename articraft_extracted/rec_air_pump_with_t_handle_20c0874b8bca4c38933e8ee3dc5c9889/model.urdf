  <joint name="pump_to_handle" type="prismatic">
    <origin xyz="0 0 0.895" rpy="0 0 0" />
    <parent link="pump" />
    <child link="handle" />
    <axis xyz="0 0 1" />
    <limit effort="120" velocity="0.6" lower="0" upper="0.32" />
    </joint>
