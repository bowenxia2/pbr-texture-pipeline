  <joint name="body_to_top_vent" type="fixed">
    <parent link="body" />
    <child link="top_vent" />
    </joint>
  <joint name="body_to_dial" type="continuous">
    <origin xyz="0 0 0.676" rpy="0 0 0" />
    <parent link="body" />
    <child link="dial" />
    <axis xyz="0 0 1" />
    <limit effort="0.4" velocity="8" />
