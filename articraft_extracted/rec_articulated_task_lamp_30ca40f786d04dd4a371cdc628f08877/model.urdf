<robot name="bench_lamp">
  <material name="base_gray">
    <color rgba="0.23 0.24 0.26 1" />
    </material>
  <material name="arm_satin">
    <color rgba="0.63 0.65 0.68 1" />
    </material>
  <material name="head_black">
    <color rgba="0.12 0.12 0.13 1" />
    </material>
  <material name="switch_black">
    <color rgba="0.09 0.09 0.1 1" />
    </material>
  <link name="base">
    <visual name="base_shell">
      <geometry>
        <mesh filename="assets/meshes/base_shell.obj" />
        </geometry>
      <material name="base_gray" />
      </visual>
    <collision name="base_shell">
      <geometry>
        <mesh filename="assets/meshes/base_shell.obj" />
        </geometry>
      </collision>
    </link>
  <link name="lower_link">
    <visual name="lower_frame">
      <geometry>
        <mesh filename="assets/meshes/lower_link.obj" />
        </geometry>
      <material name="arm_satin" />
      </visual>
    <collision name="lower_frame">
      <geometry>
        <mesh filename="assets/meshes/lower_link.obj" />
        </geometry>
      </collision>
    </link>
  <link name="upper_link">
    <visual name="upper_frame">
      <geometry>
        <mesh filename="assets/meshes/upper_link.obj" />
        </geometry>
      <material name="arm_satin" />
      </visual>
    <collision name="upper_frame">
      <geometry>
        <mesh filename="assets/meshes/upper_link.obj" />
        </geometry>
      </collision>
    </link>
  <link name="head">
    <visual name="head_shell">
      <geometry>
        <mesh filename="assets/meshes/head_shell.obj" />
        </geometry>
      <material name="head_black" />
      </visual>
    <collision name="head_shell">
      <geometry>
        <mesh filename="assets/meshes/head_shell.obj" />
        </geometry>
      </collision>
    </link>
  <link name="switch">
    <visual name="rocker_body">
      <geometry>
        <mesh filename="assets/meshes/rocker_switch.obj" />
        </geometry>
      <material name="switch_black" />
      </visual>
    <collision name="rocker_body">
      <geometry>
        <mesh filename="assets/meshes/rocker_switch.obj" />
        </geometry>
      </collision>
    </link>
  <joint name="base_hinge" type="revolute">
    <origin xyz="-0.02 0 0.052" rpy="0 -0.85 0" />
    <parent link="base" />
    <child link="lower_link" />
    <axis xyz="0 -1 0" />
    <limit effort="10" velocity="1.8" lower="-0.55" upper="0.65" />
    </joint>
  <joint name="elbow_hinge" type="revolute">
    <origin xyz="0.12 0 0" rpy="0 0.45 0" />
    <parent link="lower_link" />
    <child link="upper_link" />
    <axis xyz="0 -1 0" />
    <limit effort="8" velocity="2" lower="-0.9" upper="0.9" />
    </joint>
  <joint name="head_hinge" type="revolute">
    <origin xyz="0.108 0 0" rpy="0 0.95 0" />
    <parent link="upper_link" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="4" velocity="2.5" lower="-0.55" upper="0.8" />
    </joint>
  <joint name="switch_hinge" type="revolute">
    <origin xyz="0.034 0.059 0.013" rpy="0 0 0" />
    <parent link="base" />
    <child link="switch" />
    <axis xyz="1 0 0" />
    <limit effort="0.4" velocity="4" lower="-0.3" upper="0.3" />
    </joint>
  </robot>
