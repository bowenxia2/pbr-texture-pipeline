    <child link="release_button" />
    <axis xyz="0 0 -1" />
    <limit effort="12" velocity="0.1" lower="0" upper="0.004" />
    </joint>
  <joint name="body_to_timer_knob" type="continuous">
    <origin xyz="0.008 0 0.316" rpy="0 0 0" />
    <parent link="body" />
    <child link="timer_knob" />
    <axis xyz="0 0 1" />
    <limit effort="0.3" velocity="6" />
    </joint>
  <joint name="body_to_program_button" type="prismatic">
    <origin xyz="0.155 0 0.208" rpy="0 0 0" />
    <parent link="body" />
    <child link="program_button" />
    <axis xyz="-1 0 0" />
    <limit effort="10" velocity="0.08" lower="0" upper="0.004" />
    </joint>
  <joint name="body_to_power_rocker" type="revolute">
    <origin xyz="0.04 0.13 0.195" rpy="0 0 0" />
    <parent link="body" />
    <child link="power_rocker" />
    <axis xyz="1 0 0" />
    <limit effort="1" velocity="2.5" lower="-0.28" upper="0.28" />
    </joint>
  </robot>
