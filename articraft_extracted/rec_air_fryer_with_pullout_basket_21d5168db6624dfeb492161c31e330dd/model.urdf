  <joint name="body_to_basket" type="prismatic">
    <origin xyz="0.156 0 0.096" rpy="0 0 0" />
    <parent link="body" />
    <child link="basket" />
    <axis xyz="1 0 0" />
    <limit effort="45" velocity="0.28" lower="0" upper="0.115" />
    </joint>
  <joint name="basket_to_release_button" type="prismatic">
    <origin xyz="0.049 0 0.012" rpy="0 0 0" />
