  <joint name="bracket_to_first_arm" type="revolute">
    <origin xyz="0.033 0 0.07" rpy="0 0 0" />
    <parent link="wall_bracket" />
    <child link="first_arm" />
    <axis xyz="0 -1 0" />
    <limit effort="10" velocity="1.5" lower="-1.3" upper="1.1" />
    </joint>
  <joint name="first_to_second_arm" type="revolute">
    <origin xyz="0.16 0 0" rpy="0 0 0" />
