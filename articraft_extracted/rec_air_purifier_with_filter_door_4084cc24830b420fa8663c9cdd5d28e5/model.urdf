  <joint name="base_to_lower_housing" type="fixed">
    <origin xyz="0 0 0.271" rpy="0 0 0" />
    <parent link="base" />
    <child link="lower_housing" />
    </joint>
  <joint name="housing_cap_spin" type="continuous">
    <parent link="lower_housing" />
    <child link="top_cap" />
    <axis xyz="0 0 1" />
    <limit effort="2.5" velocity="6" />
    </joint>
  <joint name="base_to_filter_drawer" type="prismatic">
    <origin xyz="0 0.147 0.012" rpy="0 0 0" />
    <parent link="base" />
    <child link="filter_drawer" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="0.18" lower="0" upper="0.085" />
    </joint>
  </robot>
