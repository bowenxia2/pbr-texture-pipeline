  <joint name="pump_slide" type="prismatic">
    <origin xyz="0 0 0.685" rpy="0 0 0" />
    <parent link="base" />
    <child link="slider" />
    <axis xyz="0 0 1" />
    <limit effort="180" velocity="1.4" lower="0" upper="0.28" />
    </joint>
  <joint name="grip_roll" type="continuous">
    <origin xyz="0 0 0.29" rpy="0 0 0" />
    <parent link="slider" />
    <child link="grip" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="6" />
    </joint>
  <joint name="gauge_spin" type="continuous">
    <origin xyz="0 0.116 0.245" rpy="0 0 0" />
