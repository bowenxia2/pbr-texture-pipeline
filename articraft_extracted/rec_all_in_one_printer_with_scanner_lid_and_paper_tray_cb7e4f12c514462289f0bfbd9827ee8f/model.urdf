<robot name="compact_all_in_one_printer">
  <material name="body_graphite">
    <color rgba="0.21 0.22 0.24 1" />
    </material>
  <material name="lid_dark">
    <color rgba="0.3 0.31 0.33 1" />
    </material>
  <material name="tray_black">
    <color rgba="0.16 0.17 0.18 1" />
    </material>
  <material name="door_smoke">
    <color rgba="0.24 0.25 0.27 1" />
    </material>
  <material name="panel_black">
    <color rgba="0.1 0.11 0.12 1" />
    </material>
  <material name="knob_black">
    <color rgba="0.08 0.08 0.09 1" />
    </material>
  <material name="button_grey">
    <color rgba="0.62 0.64 0.67 1" />
    </material>
  <material name="scanner_glass">
    <color rgba="0.43 0.56 0.61 0.35" />
    </material>
  <link name="chassis">
    <visual name="shell">
      <geometry>
        <mesh filename="assets/meshes/printer_chassis.obj" />
        </geometry>
      <material name="body_graphite">
        <color rgba="0.21 0.22 0.24 1" />
        </material>
      </visual>
    <collision name="shell">
      <geometry>
        <mesh filename="assets/meshes/printer_chassis.obj" />
        </geometry>
      </collision>
    </link>
  <link name="lid">
    <visual name="shell">
      <geometry>
        <mesh filename="assets/meshes/printer_lid.obj" />
        </geometry>
      <material name="lid_dark">
        <color rgba="0.3 0.31 0.33 1" />
        </material>
      </visual>
    <collision name="shell">
      <geometry>
        <mesh filename="assets/meshes/printer_lid.obj" />
        </geometry>
      </collision>
    </link>
  <link name="tray">
    <visual name="drawer">
      <geometry>
        <mesh filename="assets/meshes/printer_tray.obj" />
        </geometry>
      <material name="tray_black">
        <color rgba="0.16 0.17 0.18 1" />
        </material>
      </visual>
    <collision name="drawer">
      <geometry>
        <mesh filename="assets/meshes/printer_tray.obj" />
        </geometry>
      </collision>
    </link>
  <link name="output_door">
    <visual name="panel">
      <geometry>
        <mesh filename="assets/meshes/printer_output_door.obj" />
        </geometry>
      <material name="door_smoke">
        <color rgba="0.24 0.25 0.27 1" />
        </material>
      </visual>
    <collision name="panel">
      <geometry>
        <mesh filename="assets/meshes/printer_output_door.obj" />
        </geometry>
      </collision>
    </link>
  <link name="control_panel">
    <visual name="panel">
      <geometry>
        <mesh filename="assets/meshes/printer_control_panel.obj" />
        </geometry>
      <material name="panel_black">
        <color rgba="0.1 0.11 0.12 1" />
        </material>
      </visual>
    <collision name="panel">
      <geometry>
        <mesh filename="assets/meshes/printer_control_panel.obj" />
        </geometry>
      </collision>
    </link>
  <link name="scanner_bed">
    <visual name="glass">
      <origin xyz="0 0 0.0015" rpy="0 0 0" />
      <geometry>
        <box size="0.272 0.2 0.003" />
        </geometry>
      <material name="scanner_glass">
        <color rgba="0.43 0.56 0.61 0.35" />
        </material>
      </visual>
    <collision name="glass">
      <origin xyz="0 0 0.0015" rpy="0 0 0" />
      <geometry>
        <box size="0.272 0.2 0.003" />
        </geometry>
      </collision>
    </link>
  <link name="selector_knob">
    <visual name="skirt">
      <origin xyz="0 -0.008 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.017" length="0.008" />
        </geometry>
      <material name="knob_black">
        <color rgba="0.08 0.08 0.09 1" />
        </material>
      </visual>
    <visual name="cap">
      <origin xyz="0 -0.013 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.013" length="0.012" />
        </geometry>
      <material name="knob_black">
        <color rgba="0.08 0.08 0.09 1" />
        </material>
      </visual>
    <visual name="pointer">
      <origin xyz="0.01 -0.019 0" rpy="0 0 0" />
      <geometry>
        <box size="0.003 0.0015 0.01" />
        </geometry>
      <material name="button_grey">
        <color rgba="0.62 0.64 0.67 1" />
        </material>
      </visual>
    <collision name="skirt">
      <origin xyz="0 -0.008 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.017" length="0.008" />
        </geometry>
      </collision>
    <collision name="cap">
      <origin xyz="0 -0.013 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.013" length="0.012" />
        </geometry>
      </collision>
    <collision name="pointer">
      <origin xyz="0.01 -0.019 0" rpy="0 0 0" />
      <geometry>
        <box size="0.003 0.0015 0.01" />
        </geometry>
      </collision>
    </link>
  <link name="button_0">
    <visual name="cap">
      <origin xyz="0 -0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.004 0.01" />
        </geometry>
      <material name="button_grey">
        <color rgba="0.62 0.64 0.67 1" />
        </material>
      </visual>
    <collision name="cap">
      <origin xyz="0 -0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.004 0.01" />
        </geometry>
      </collision>
    </link>
  <link name="button_1">
    <visual name="cap">
      <origin xyz="0 -0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.004 0.01" />
        </geometry>
      <material name="button_grey">
        <color rgba="0.62 0.64 0.67 1" />
        </material>
      </visual>
    <collision name="cap">
      <origin xyz="0 -0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.004 0.01" />
        </geometry>
      </collision>
    </link>
  <link name="button_2">
    <visual name="cap">
      <origin xyz="0 -0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.004 0.01" />
        </geometry>
      <material name="button_grey">
        <color rgba="0.62 0.64 0.67 1" />
        </material>
      </visual>
    <collision name="cap">
      <origin xyz="0 -0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.004 0.01" />
        </geometry>
      </collision>
    </link>
  <joint name="lid_hinge" type="revolute">
    <origin xyz="0 0.128 0.27" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="lid" />
    <axis xyz="-1 0 0" />
    <limit effort="10" velocity="1.6" lower="0" upper="1.3" />
    </joint>
  <joint name="tray_slide" type="prismatic">
    <origin xyz="0 -0.18 0.018" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="tray" />
    <axis xyz="0 -1 0" />
    <limit effort="30" velocity="0.3" lower="0" upper="0.108" />
    </joint>
  <joint name="output_door_hinge" type="revolute">
    <origin xyz="0 -0.18 0.09" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="output_door" />
    <axis xyz="1 0 0" />
    <limit effort="4" velocity="2" lower="0" upper="1.45" />
    </joint>
  <joint name="chassis_to_control_panel" type="fixed">
    <origin xyz="0 -0.176 0.192" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="control_panel" />
    </joint>
  <joint name="chassis_to_scanner_bed" type="fixed">
    <origin xyz="0 0.01 0.252" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="scanner_bed" />
    </joint>
  <joint name="selector_knob_spin" type="continuous">
    <origin xyz="-0.04 0 0.01" rpy="0 0 0" />
    <parent link="control_panel" />
    <child link="selector_knob" />
    <axis xyz="0 1 0" />
    <limit effort="0.12" velocity="6" />
    </joint>
  <joint name="button_0_push" type="prismatic">
    <origin xyz="0.028 0 -0.01" rpy="0 0 0" />
    <parent link="control_panel" />
    <child link="button_0" />
    <axis xyz="0 1 0" />
    <limit effort="6" velocity="0.08" lower="0" upper="0.003" />
    </joint>
  <joint name="button_1_push" type="prismatic">
    <origin xyz="0.054 0 -0.01" rpy="0 0 0" />
    <parent link="control_panel" />
    <child link="button_1" />
    <axis xyz="0 1 0" />
    <limit effort="6" velocity="0.08" lower="0" upper="0.003" />
    </joint>
  <joint name="button_2_push" type="prismatic">
    <origin xyz="0.08 0 -0.01" rpy="0 0 0" />
    <parent link="control_panel" />
    <child link="button_2" />
    <axis xyz="0 1 0" />
    <limit effort="6" velocity="0.08" lower="0" upper="0.003" />
    </joint>
  </robot>
