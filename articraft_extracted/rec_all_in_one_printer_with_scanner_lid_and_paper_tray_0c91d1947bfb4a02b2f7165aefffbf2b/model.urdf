  <joint name="body_to_scanner_glass" type="fixed">
    <origin xyz="-0.075 -0.005 0.171" rpy="0 0 0" />
    <parent link="body" />
    <child link="scanner_glass" />
    </joint>
  <joint name="body_to_lid_mount" type="fixed">
    <origin xyz="-0.075 0.0985 0.185" rpy="0 0 0" />
    <parent link="body" />
    <child link="lid_mount" />
    </joint>
  <joint name="body_to_lid" type="revolute">
    <origin xyz="-0.075 0.1075 0.188" rpy="0 0 0" />
    <parent link="body" />
    <child link="lid" />
    <axis xyz="-1 0 0" />
    <limit effort="18" velocity="1.4" lower="0" upper="1.24" />
    </joint>
  <joint name="lid_to_adf_lid" type="revolute">
    <origin xyz="0 -0.035 0.054" rpy="0 0 0" />
    <parent link="lid" />
    <child link="adf_lid" />
    <axis xyz="-1 0 0" />
    <limit effort="8" velocity="1.5" lower="0" upper="1.1" />
    </joint>
  <joint name="body_to_cassette" type="prismatic">
    <origin xyz="0 -0.225 0.012" rpy="0 0 0" />
    <parent link="body" />
    <child link="cassette" />
    <axis xyz="0 -1 0" />
    <limit effort="70" velocity="0.18" lower="0" upper="0.13" />
    </joint>
  <joint name="body_to_tray_flap" type="revolute">
