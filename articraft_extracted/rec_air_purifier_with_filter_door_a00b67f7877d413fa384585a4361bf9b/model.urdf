<robot name="bedside_air_purifier">
  <link name="body">
    <visual name="body_shell">
      <geometry>
        <mesh filename="assets/meshes/body_shell.obj" />
        </geometry>
      <material name="warm_white_plastic">
        <color rgba="0.88 0.9 0.88 1" />
        </material>
      </visual>
    <visual name="base_foot">
      <origin xyz="0 0 0.009" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.098" length="0.018" />
        </geometry>
      <material name="soft_gray_rubber">
        <color rgba="0.18 0.19 0.2 1" />
        </material>
      </visual>
    <visual name="filter_socket">
      <geometry>
        <mesh filename="assets/meshes/filter_socket.obj" />
        </geometry>
      <material name="soft_gray_rubber">
        <color rgba="0.18 0.19 0.2 1" />
        </material>
      </visual>
    <visual name="lock_mark">
      <origin xyz="0.089 -0.022 0.397" rpy="0 0 0" />
      <geometry>
        <box size="0.006 0.006 0.026" />
        </geometry>
      <material name="charcoal_detail">
        <color rgba="0.02 0.025 0.03 1" />
        </material>
      </visual>
    <visual name="unlock_mark">
      <origin xyz="0.089 0.022 0.397" rpy="0 0 0" />
      <geometry>
        <box size="0.006 0.006 0.026" />
        </geometry>
      <material name="blue_unlock_mark">
        <color rgba="0.05 0.3 0.9 1" />
        </material>
      </visual>
    </link>
  <link name="top_cap">
    <visual name="cap_shell">
      <geometry>
        <mesh filename="assets/meshes/top_cap_shell_above_rim.obj" />
        </geometry>
      <material name="warm_white_plastic">
        <color rgba="0.88 0.9 0.88 1" />
        </material>
      </visual>
    <visual name="unlock_pointer">
      <origin xyz="0.083 0 0.0215" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.005" length="0.004" />
        </geometry>
      <material name="blue_unlock_mark">
        <color rgba="0.05 0.3 0.9 1" />
        </material>
      </visual>
    </link>
  <link name="filter">
    <visual name="filter_media">
      <geometry>
        <mesh filename="assets/meshes/filter_media_pleated.obj" />
        </geometry>
      <material name="pleated_filter_paper">
        <color rgba="0.83 0.76 0.58 1" />
        </material>
      </visual>
    <visual name="filter_top_ring">
      <geometry>
        <mesh filename="assets/meshes/filter_top_ring_hollow.obj" />
        </geometry>
      <material name="warm_white_plastic">
        <color rgba="0.88 0.9 0.88 1" />
        </material>
      </visual>
    <visual name="filter_bottom_ring">
      <geometry>
        <mesh filename="assets/meshes/filter_bottom_ring_hollow.obj" />
        </geometry>
      <material name="warm_white_plastic">
        <color rgba="0.88 0.9 0.88 1" />
        </material>
      </visual>
    <visual name="perforated_core">
      <origin xyz="0 0 -0.162" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.022" length="0.292" />
        </geometry>
      <material name="charcoal_detail">
        <color rgba="0.02 0.025 0.03 1" />
        </material>
      </visual>
    </link>
  <joint name="body_to_top_cap" type="revolute">
    <origin xyz="0 0 0.429" rpy="0 0 0" />
    <parent link="body" />
    <child link="top_cap" />
    <axis xyz="0 0 1" />
    <limit effort="1.5" velocity="1" lower="0" upper="0.959931" />
    </joint>
  <joint name="body_to_filter" type="prismatic">
    <origin xyz="0 0 0.405" rpy="0 0 0" />
    <parent link="body" />
    <child link="filter" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="0.25" lower="0" upper="0.245" />
    </joint>
  </robot>
