  <joint name="base_to_carriage" type="prismatic">
    <origin xyz="0.03 0 0.055" rpy="0 0 0" />
    <parent link="base" />
    <child link="carriage" />
    <axis xyz="1 0 0" />
    <limit effort="20" velocity="0.08" lower="0" upper="0.028" />
    </joint>
  <joint name="carriage_to_bowl" type="fixed">
    <origin xyz="0.095 0 0.07" rpy="0 0 0" />
    <parent link="carriage" />
    <child link="bowl" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.09 0 0.305" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="15" velocity="1" lower="0" upper="1.0821" />
    </joint>
  <joint name="head_to_whisk" type="continuous">
    <origin xyz="0.218 0 -0.068" rpy="0 0 0" />
    <parent link="head" />
    <child link="whisk" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="20" />
    </joint>
  <joint name="base_to_speed_lever" type="revolute">
    <origin xyz="-0.03 0.073 0.193" rpy="0 0 0" />
