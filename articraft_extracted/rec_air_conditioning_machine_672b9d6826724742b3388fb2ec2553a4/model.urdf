<robot name="cassette_air_conditioner">
  <material name="panel_white">
    <color rgba="0.95 0.95 0.93 1" />
    </material>
  <material name="louver_white">
    <color rgba="0.88 0.88 0.85 1" />
    </material>
  <material name="louver_shadow">
    <color rgba="0.7 0.7 0.67 1" />
    </material>
  <link name="panel">
    <visual name="panel_shell">
      <geometry>
        <mesh filename="assets/meshes/cassette_panel.obj" />
        </geometry>
      <material name="panel_white" />
      </visual>
    <collision name="panel_shell">
      <geometry>
        <mesh filename="assets/meshes/cassette_panel.obj" />
        </geometry>
      </collision>
    </link>
  <link name="north_flap">
    <visual name="flap_surface">
      <origin xyz="0 -0.043 -0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.468 0.086 0.006" />
        </geometry>
      <material name="louver_white" />
      </visual>
    <collision name="flap_surface">
      <origin xyz="0 -0.043 -0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.468 0.086 0.006" />
        </geometry>
      </collision>
    </link>
  <link name="south_flap">
    <visual name="flap_surface">
      <origin xyz="0 0.043 -0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.468 0.086 0.006" />
        </geometry>
      <material name="louver_white" />
      </visual>
    <collision name="flap_surface">
      <origin xyz="0 0.043 -0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.468 0.086 0.006" />
        </geometry>
      </collision>
    </link>
  <link name="east_flap">
    <visual name="flap_surface">
      <origin xyz="-0.043 0 -0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.086 0.468 0.006" />
        </geometry>
      <material name="louver_white" />
      </visual>
    <collision name="flap_surface">
      <origin xyz="-0.043 0 -0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.086 0.468 0.006" />
        </geometry>
      </collision>
    </link>
  <link name="west_flap">
    <visual name="flap_surface">
      <origin xyz="0.043 0 -0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.086 0.468 0.006" />
        </geometry>
      <material name="louver_white" />
      </visual>
    <collision name="flap_surface">
      <origin xyz="0.043 0 -0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.086 0.468 0.006" />
        </geometry>
      </collision>
    </link>
  <link name="inspection_panel">
    <visual name="door_leaf">
      <origin xyz="0 -0.056 -0.002" rpy="0 0 0" />
      <geometry>
        <box size="0.054 0.112 0.004" />
        </geometry>
      <material name="panel_white" />
      </visual>
    <visual name="hinge_barrel">
      <origin xyz="0 -0.0022 -0.0022" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0022" length="0.042" />
        </geometry>
      <material name="louver_shadow" />
      </visual>
    <visual name="latch_pull">
      <origin xyz="0 -0.104 0.0008" rpy="0 0 0" />
      <geometry>
        <box size="0.0189 0.01 0.0016" />
        </geometry>
      <material name="louver_shadow" />
      </visual>
    <collision name="door_leaf">
      <origin xyz="0 -0.056 -0.002" rpy="0 0 0" />
      <geometry>
        <box size="0.054 0.112 0.004" />
        </geometry>
      </collision>
    <collision name="hinge_barrel">
      <origin xyz="0 -0.0022 -0.0022" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0022" length="0.042" />
        </geometry>
      </collision>
    <collision name="latch_pull">
      <origin xyz="0 -0.104 0.0008" rpy="0 0 0" />
      <geometry>
        <box size="0.0189 0.01 0.0016" />
        </geometry>
      </collision>
    </link>
  <joint name="panel_to_north_flap" type="revolute">
    <origin xyz="0 0.385 0.006" rpy="0 0 0" />
    <parent link="panel" />
    <child link="north_flap" />
    <axis xyz="-1 0 0" />
    <limit effort="8" velocity="1.6" lower="0" upper="0.95" />
    </joint>
  <joint name="panel_to_south_flap" type="revolute">
    <origin xyz="0 -0.385 0.006" rpy="0 0 0" />
    <parent link="panel" />
    <child link="south_flap" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="1.6" lower="0" upper="0.95" />
    </joint>
  <joint name="panel_to_east_flap" type="revolute">
    <origin xyz="0.385 0 0.006" rpy="0 0 0" />
    <parent link="panel" />
    <child link="east_flap" />
    <axis xyz="0 1 0" />
    <limit effort="8" velocity="1.6" lower="0" upper="0.95" />
    </joint>
  <joint name="panel_to_west_flap" type="revolute">
    <origin xyz="-0.385 0 0.006" rpy="0 0 0" />
    <parent link="panel" />
    <child link="west_flap" />
    <axis xyz="0 -1 0" />
    <limit effort="8" velocity="1.6" lower="0" upper="0.95" />
    </joint>
  <joint name="panel_to_inspection_panel" type="revolute">
    <origin xyz="0.428 -0.094 0" rpy="0 0 0" />
    <parent link="panel" />
    <child link="inspection_panel" />
    <axis xyz="-1 0 0" />
    <limit effort="3" velocity="1.5" lower="0" upper="1.1" />
    </joint>
  </robot>
