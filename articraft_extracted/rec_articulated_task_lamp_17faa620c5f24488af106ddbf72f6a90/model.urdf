  <joint name="base_yaw" type="revolute">
    <parent link="wall_bracket" />
    <child link="link_1" />
    <axis xyz="0 0 1" />
    <limit effort="5" velocity="2" lower="-1.25" upper="1.25" />
    </joint>
  <joint name="elbow_yaw" type="revolute">
