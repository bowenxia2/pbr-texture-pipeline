  <joint name="barrel_to_handle" type="prismatic">
    <origin xyz="0 0 0.274" rpy="0 0 0" />
    <parent link="base_barrel" />
    <child link="handle_rod" />
    <axis xyz="0 0 1" />
    <limit effort="55" velocity="0.3" lower="0" upper="0.1" />
    </joint>
  <joint name="base_to_foot_0" type="revolute">
    <origin xyz="0 0.047 0.031" rpy="0 0 0" />
    <parent link="base_barrel" />
    <child link="foot_0" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="2" lower="0" upper="1.55" />
    </joint>
  <joint name="base_to_foot_1" type="revolute">
    <origin xyz="0 -0.047 0.031" rpy="0 0 3.14159" />
