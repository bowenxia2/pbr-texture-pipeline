  <joint name="bracket_to_first_link" type="revolute">
    <parent link="wall_bracket" />
    <child link="first_link" />
    <axis xyz="0 0 1" />
    <limit effort="8" velocity="2.5" lower="-1.45" upper="1.45" />
    </joint>
  <joint name="first_to_second_link" type="revolute">
