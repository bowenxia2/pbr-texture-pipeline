  <joint name="body_to_drawer" type="prismatic">
    <origin xyz="0.03 0 0.055" rpy="0 0 0" />
    <parent link="body" />
    <child link="drawer" />
    <axis xyz="1 0 0" />
    <limit effort="70" velocity="0.35" lower="-0.03" upper="0.18" />
    </joint>
