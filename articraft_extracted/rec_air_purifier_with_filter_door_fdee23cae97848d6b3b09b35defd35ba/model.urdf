<robot name="cylindrical_air_purifier">
  <material name="body_white">
    <color rgba="0.94 0.95 0.94 1" />
    </material>
  <material name="door_white">
    <color rgba="0.9 0.91 0.9 1" />
    </material>
  <material name="filter_offwhite">
    <color rgba="0.93 0.92 0.86 1" />
    </material>
  <material name="ring_graphite">
    <color rgba="0.18 0.19 0.2 1" />
    </material>
  <link name="body">
    <visual name="housing">
      <geometry>
        <mesh filename="assets/meshes/purifier_body.obj" />
        </geometry>
      <material name="body_white">
        <color rgba="0.94 0.95 0.94 1" />
        </material>
      </visual>
    <collision name="housing">
      <geometry>
        <mesh filename="assets/meshes/purifier_body.obj" />
        </geometry>
      </collision>
    </link>
  <link name="rear_door">
    <visual name="door_panel">
      <geometry>
        <mesh filename="assets/meshes/purifier_rear_door.obj" />
        </geometry>
      <material name="door_white">
        <color rgba="0.9 0.91 0.9 1" />
        </material>
      </visual>
    <collision name="door_panel">
      <geometry>
        <mesh filename="assets/meshes/purifier_rear_door.obj" />
        </geometry>
      </collision>
    </link>
  <link name="filter">
    <visual name="filter_cartridge">
      <geometry>
        <mesh filename="assets/meshes/purifier_filter.obj" />
        </geometry>
      <material name="filter_offwhite">
        <color rgba="0.93 0.92 0.86 1" />
        </material>
      </visual>
    <collision name="filter_cartridge">
      <geometry>
        <mesh filename="assets/meshes/purifier_filter.obj" />
        </geometry>
      </collision>
    </link>
  <link name="control_ring">
    <visual name="ring_shell">
      <geometry>
        <mesh filename="assets/meshes/purifier_control_ring.obj" />
        </geometry>
      <material name="ring_graphite">
        <color rgba="0.18 0.19 0.2 1" />
        </material>
      </visual>
    <collision name="ring_shell">
      <geometry>
        <mesh filename="assets/meshes/purifier_control_ring.obj" />
        </geometry>
      </collision>
    </link>
  <joint name="body_to_rear_door" type="revolute">
    <origin xyz="0.108 -0.099 0.268" rpy="0 0 0" />
    <parent link="body" />
    <child link="rear_door" />
    <axis xyz="0 0 1" />
    <limit effort="8" velocity="1.4" lower="0" upper="1.8326" />
    </joint>
  <joint name="body_to_filter" type="prismatic">
    <origin xyz="0 -0.0915 0.268" rpy="0 0 0" />
    <parent link="body" />
    <child link="filter" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="0.18" lower="0" upper="0.11" />
    </joint>
  <joint name="body_to_control_ring" type="continuous">
    <origin xyz="0 0 0.528" rpy="0 0 0" />
    <parent link="body" />
    <child link="control_ring" />
    <axis xyz="0 0 1" />
    <limit effort="1.5" velocity="4.5" />
    </joint>
  </robot>
