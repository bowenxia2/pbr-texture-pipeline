	<joint name="body_to_door" type="revolute">
		<origin xyz="0.018 -0.17 0" rpy="0 0 0" />
		<parent link="body" />
		<child link="door" />
		<axis xyz="0 0 -1" />
		<limit effort="60" velocity="1.5" lower="0" upper="1.55" />
	</joint>
	<joint name="door_to_dial" type="continuous">
		<origin xyz="0.022 0.181 0.085" rpy="0 0 0" />
		<parent link="door" />
		<child link="dial" />
		<axis xyz="1 0 0" />
		<limit effort="1.5" velocity="6" />
	</joint>
	<joint name="door_to_handle" type="revolute">
		<origin xyz="0.022 0.181 -0.085" rpy="0 0 0" />
		<parent link="door" />
		<child link="handle" />
		<axis xyz="1 0 0" />
		<limit effort="8" velocity="4" lower="-1.1" upper="1.1" />
	</joint>
</robot>