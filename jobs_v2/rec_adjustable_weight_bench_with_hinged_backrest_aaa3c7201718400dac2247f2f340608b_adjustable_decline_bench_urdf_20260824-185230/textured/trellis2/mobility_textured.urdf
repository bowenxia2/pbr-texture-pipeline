		<origin xyz="-0.12 0 0.5" rpy="0 0 0" />
		<parent link="frame" />
		<child link="backrest" />
		<axis xyz="0 1 0" />
		<limit effort="90" velocity="1.2" lower="0" upper="1.15" />
	</joint>
	<joint name="seat_hinge" type="revolute">
		<origin xyz="0.36 0 0.5" rpy="0 0 0" />
		<parent link="frame" />
		<child link="seat" />
		<axis xyz="0 1 0" />
		<limit effort="50" velocity="1" lower="0" upper="0.45" />
	</joint>
</robot>