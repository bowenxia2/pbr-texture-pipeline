<?xml version='1.0' encoding='utf-8'?>
<robot name="cylindrical_purifier">
	<material name="shell_white">
		<color rgba="0.93 0.94 0.92 1" />
	</material>
	<material name="shell_grey">
		<color rgba="0.83 0.84 0.82 1" />
	</material>
	<material name="charcoal">
		<color rgba="0.17 0.18 0.19 1" />
	</material>
	<material name="filter_cream">
		<color rgba="0.95 0.94 0.88 1" />
	</material>
	<material name="button_black">
		<color rgba="0.09 0.09 0.1 1" />
	</material>
	<material name="accent_blue">
		<color rgba="0.35 0.57 0.72 1" />
	</material>
	<link name="lower_body">
		<collision name="body_shell">
			<geometry>
				<mesh filename="assets/meshes/purifier_lower_body.obj" />
			</geometry>
		</collision>
		<collision name="button_pad">
			<origin xyz="0.112 0 0.155" rpy="0 0 0" />
			<geometry>
				<box size="0.02 0.054 0.074" />
			</geometry>
		</collision>
		<visual name="lower_body__body_shell">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/lower_body__body_shell.glb" />
			</geometry>
		</visual>
		<visual name="lower_body__button_pad">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/lower_body__button_pad.glb" />
			</geometry>
		</visual>
	</link>
	<link name="upper_shell">
		<collision name="shell_body">
			<geometry>
				<mesh filename="assets/meshes/purifier_upper_shell.obj" />
			</geometry>
		</collision>
		<collision name="shell_badge">
			<origin xyz="0.1155 0 0.145" rpy="0 0 0" />
			<geometry>
				<box size="0.006 0.028 0.05" />
			</geometry>
		</collision>
		<visual name="upper_shell__shell_body">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/upper_shell__shell_body.glb" />
			</geometry>
		</visual>
		<visual name="upper_shell__shell_badge">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/upper_shell__shell_badge.glb" />
			</geometry>
		</visual>
	</link>
	<link name="filter_cylinder">
		<collision name="filter_body">
			<geometry>
				<mesh filename="assets/meshes/purifier_filter_cylinder.obj" />
			</geometry>
		</collision>
		<visual name="filter_cylinder__filter_body">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/filter_cylinder__filter_body.glb" />
			</geometry>
		</visual>
	</link>
	<link name="power_button">
		<collision name="button_cap">
			<origin xyz="0 0 0.002" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.013" length="0.004" />
			</geometry>
		</collision>
		<visual name="power_button__button_cap">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/power_button__button_cap.glb" />
			</geometry>
		</visual>
	</link>
	<joint name="lower_body_to_upper_shell" type="revolute">
		<origin xyz="0 0 0.31" rpy="0 0 0" />
		<parent link="lower_body" />
		<child link="upper_shell" />
		<axis xyz="0 0 1" />
		<limit effort="8" velocity="1.2" lower="0" upper="0.663225" />
	</joint>
	<joint name="lower_body_to_filter_cylinder" type="prismatic">
		<origin xyz="0 0 0.298" rpy="0 0 0" />
		<parent link="lower_body" />
		<child link="filter_cylinder" />
		<axis xyz="0 0 1" />
		<limit effort="20" velocity="0.12" lower="0" upper="0.165" />
	</joint>
	<joint name="lower_body_to_power_button" type="prismatic">
		<origin xyz="0.122 0 0.155" rpy="0 1.5708 0" />
		<parent link="lower_body" />
		<child link="power_button" />
		<axis xyz="0 0 -1" />
		<limit effort="4" velocity="0.04" lower="0" upper="0.0035" />
	</joint>
</robot>