<robot name="bedside_air_purifier">
  <material name="shell_white">
    <color rgba="0.94 0.95 0.96 1" />
    </material>
  <material name="cap_graphite">
    <color rgba="0.18 0.2 0.22 1" />
    </material>
  <material name="trim_gray">
    <color rgba="0.54 0.57 0.6 1" />
    </material>
  <material name="filter_gray">
    <color rgba="0.84 0.85 0.83 1" />
    </material>
  <material name="indicator_blue">
    <color rgba="0.41 0.72 0.9 0.95" />
    </material>
  <link name="housing">
    <visual name="housing_shell">
      <geometry>
        <mesh filename="assets/meshes/air_purifier_housing.obj" />
        </geometry>
      <material name="shell_white">
        <color rgba="0.94 0.95 0.96 1" />
        </material>
      </visual>
    <visual name="lock_mark">
      <origin xyz="0.106 0 0.317" rpy="0 0 0" />
      <geometry>
        <box size="0.012 0.004 0.004" />
        </geometry>
      <material name="trim_gray">
        <color rgba="0.54 0.57 0.6 1" />
        </material>
      </visual>
    <visual name="status_light">
      <origin xyz="0 0.106 0.12" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.005 0.003" />
        </geometry>
      <material name="indicator_blue">
        <color rgba="0.41 0.72 0.9 0.95" />
        </material>
      </visual>
    <collision name="housing_shell">
      <geometry>
        <mesh filename="assets/meshes/air_purifier_housing.obj" />
        </geometry>
      </collision>
    <collision name="lock_mark">
      <origin xyz="0.106 0 0.317" rpy="0 0 0" />
      <geometry>
        <box size="0.012 0.004 0.004" />
        </geometry>
      </collision>
    <collision name="status_light">
      <origin xyz="0 0.106 0.12" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.005 0.003" />
        </geometry>
      </collision>
    </link>
  <link name="cap">
    <visual name="cap_ring">
      <geometry>
        <mesh filename="assets/meshes/air_purifier_cap.obj" />
        </geometry>
      <material name="cap_graphite">
        <color rgba="0.18 0.2 0.22 1" />
        </material>
      </visual>
    <visual name="grip_tab">
      <origin xyz="0 0.108 0.0175" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.008 0.0035" />
        </geometry>
      <material name="trim_gray">
        <color rgba="0.54 0.57 0.6 1" />
        </material>
      </visual>
    <collision name="cap_ring">
      <geometry>
        <mesh filename="assets/meshes/air_purifier_cap.obj" />
        </geometry>
      </collision>
    <collision name="grip_tab">
      <origin xyz="0 0.108 0.0175" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.008 0.0035" />
        </geometry>
      </collision>
    </link>
  <link name="filter">
    <visual name="filter_cartridge">
      <geometry>
        <mesh filename="assets/meshes/air_purifier_filter.obj" />
        </geometry>
      <material name="filter_gray">
        <color rgba="0.84 0.85 0.83 1" />
        </material>
      </visual>
    <collision name="filter_cartridge">
      <geometry>
        <mesh filename="assets/meshes/air_purifier_filter.obj" />
        </geometry>
      </collision>
    </link>
  <joint name="cap_lock" type="revolute">
    <origin xyz="0 0 0.318" rpy="0 0 0" />
    <parent link="housing" />
    <child link="cap" />
    <axis xyz="0 0 1" />
    <limit effort="0.4" velocity="2" lower="0" upper="0.558505" />
    </joint>
  <joint name="filter_slide" type="prismatic">
    <origin xyz="0 0 0.035" rpy="0 0 0" />
    <parent link="housing" />
    <child link="filter" />
    <axis xyz="0 0 1" />
    <limit effort="6" velocity="0.12" lower="0" upper="0.13" />
    </joint>
  </robot>
