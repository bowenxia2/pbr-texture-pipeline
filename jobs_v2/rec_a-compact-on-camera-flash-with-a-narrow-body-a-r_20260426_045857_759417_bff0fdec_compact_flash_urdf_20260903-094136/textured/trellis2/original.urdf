<robot name="compact_flash">
  <link name="body">
    <visual name="shoe_plate">
      <origin xyz="0 0 0.001" rpy="0 0 0" />
      <geometry>
        <box size="0.025 0.025 0.002" />
        </geometry>
      </visual>
    <visual name="shoe_stem">
      <origin xyz="0 0 0.006" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.008" />
        </geometry>
      </visual>
    <visual name="main_body">
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.045 0.03 0.08" />
        </geometry>
      </visual>
    </link>
  <link name="swivel">
    <visual name="swivel_cylinder">
      <origin xyz="0 0 0.005" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.012" />
        </geometry>
      </visual>
    <visual name="cradle_left">
      <origin xyz="-0.018 0 0.0125" rpy="0 0 0" />
      <geometry>
        <box size="0.008 0.02 0.015" />
        </geometry>
      </visual>
    <visual name="cradle_right">
      <origin xyz="0.018 0 0.0125" rpy="0 0 0" />
      <geometry>
        <box size="0.008 0.02 0.015" />
        </geometry>
      </visual>
    <visual name="tilt_pin">
      <origin xyz="0 0 0.015" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.003" length="0.036" />
        </geometry>
      </visual>
    </link>
  <link name="head">
    <visual name="head_body">
      <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <box size="0.028 0.02 0.05" />
        </geometry>
      </visual>
    <visual name="flash_window">
      <origin xyz="0 0.011 0.03" rpy="0 0 0" />
      <geometry>
        <box size="0.024 0.002 0.03" />
        </geometry>
      </visual>
    </link>
  <link name="button_0">
    <visual name="button_0_visual">
      <geometry>
        <box size="0.004 0.01 0.008" />
        </geometry>
      </visual>
    </link>
  <link name="button_1">
    <visual name="button_1_visual">
      <geometry>
        <box size="0.004 0.01 0.008" />
        </geometry>
      </visual>
    </link>
  <link name="button_2">
    <visual name="button_2_visual">
      <geometry>
        <box size="0.004 0.01 0.008" />
        </geometry>
      </visual>
    </link>
  <joint name="body_to_swivel" type="revolute">
    <origin xyz="0 0 0.09" rpy="0 0 0" />
    <parent link="body" />
    <child link="swivel" />
    <axis xyz="0 0 1" />
    <limit effort="1" velocity="1" lower="-1.57" upper="1.57" />
    </joint>
  <joint name="swivel_to_head" type="revolute">
    <origin xyz="0 0 0.015" rpy="0 0 0" />
    <parent link="swivel" />
    <child link="head" />
    <axis xyz="1 0 0" />
    <limit effort="1" velocity="1" lower="-0.2" upper="1.57" />
    </joint>
  <joint name="body_to_button_0" type="prismatic">
    <origin xyz="0.0245 0 0.03" rpy="0 0 0" />
    <parent link="body" />
    <child link="button_0" />
    <axis xyz="1 0 0" />
    <limit effort="1" velocity="1" lower="-0.003" upper="0" />
    </joint>
  <joint name="body_to_button_1" type="prismatic">
    <origin xyz="0.0245 0 0.05" rpy="0 0 0" />
    <parent link="body" />
    <child link="button_1" />
    <axis xyz="1 0 0" />
    <limit effort="1" velocity="1" lower="-0.003" upper="0" />
    </joint>
  <joint name="body_to_button_2" type="prismatic">
    <origin xyz="0.0245 0 0.07" rpy="0 0 0" />
    <parent link="body" />
    <child link="button_2" />
    <axis xyz="1 0 0" />
    <limit effort="1" velocity="1" lower="-0.003" upper="0" />
    </joint>
  </robot>
