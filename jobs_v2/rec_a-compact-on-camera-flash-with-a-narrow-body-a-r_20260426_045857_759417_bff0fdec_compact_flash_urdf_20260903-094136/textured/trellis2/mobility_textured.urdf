<?xml version='1.0' encoding='utf-8'?>
<robot name="compact_flash">
	<link name="body">
		<visual name="body__shoe_plate">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/body__shoe_plate.glb" />
			</geometry>
		</visual>
		<visual name="body__shoe_stem">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/body__shoe_stem.glb" />
			</geometry>
		</visual>
		<visual name="body__main_body">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/body__main_body.glb" />
			</geometry>
		</visual>
	</link>
	<link name="swivel">
		<visual name="swivel__swivel_cylinder">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/swivel__swivel_cylinder.glb" />
			</geometry>
		</visual>
		<visual name="swivel__cradle_left">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/swivel__cradle_left.glb" />
			</geometry>
		</visual>
		<visual name="swivel__cradle_right">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/swivel__cradle_right.glb" />
			</geometry>
		</visual>
		<visual name="swivel__tilt_pin">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/swivel__tilt_pin.glb" />
			</geometry>
		</visual>
	</link>
	<link name="head">
		<visual name="head__head_body">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/head__head_body.glb" />
			</geometry>
		</visual>
		<visual name="head__flash_window">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/head__flash_window.glb" />
			</geometry>
		</visual>
	</link>
	<link name="button_0">
		<visual name="button_0__button_0_visual">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/button_0__button_0_visual.glb" />
			</geometry>
		</visual>
	</link>
	<link name="button_1">
		<visual name="button_1__button_1_visual">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/button_1__button_1_visual.glb" />
			</geometry>
		</visual>
	</link>
	<link name="button_2">
		<visual name="button_2__button_2_visual">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/button_2__button_2_visual.glb" />
			</geometry>
		</visual>
	</link>
	<joint name="body_to_swivel" type="revolute">
		<origin xyz="0 0 0.09" rpy="0 0 0" />
		<parent link="body" />
		<child link="swivel" />
		<axis xyz="0 0 1" />
		<limit effort="1" velocity="1" lower="-1.57" upper="1.57" />
	</joint>
	<joint name="swivel_to_head" type="revolute">
		<origin xyz="0 0 0.015" rpy="0 0 0" />
		<parent link="swivel" />
		<child link="head" />
		<axis xyz="1 0 0" />
		<limit effort="1" velocity="1" lower="-0.2" upper="1.57" />
	</joint>
	<joint name="body_to_button_0" type="prismatic">
		<origin xyz="0.0245 0 0.03" rpy="0 0 0" />
		<parent link="body" />
		<child link="button_0" />
		<axis xyz="1 0 0" />
		<limit effort="1" velocity="1" lower="-0.003" upper="0" />
	</joint>
	<joint name="body_to_button_1" type="prismatic">
		<origin xyz="0.0245 0 0.05" rpy="0 0 0" />
		<parent link="body" />
		<child link="button_1" />
		<axis xyz="1 0 0" />
		<limit effort="1" velocity="1" lower="-0.003" upper="0" />
	</joint>
	<joint name="body_to_button_2" type="prismatic">
		<origin xyz="0.0245 0 0.07" rpy="0 0 0" />
		<parent link="body" />
		<child link="button_2" />
		<axis xyz="1 0 0" />
		<limit effort="1" velocity="1" lower="-0.003" upper="0" />
	</joint>
</robot>