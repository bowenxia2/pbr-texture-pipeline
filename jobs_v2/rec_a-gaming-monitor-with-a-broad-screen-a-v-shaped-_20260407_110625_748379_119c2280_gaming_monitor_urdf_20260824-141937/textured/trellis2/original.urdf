  <joint name="base_to_swivel" type="revolute">
    <origin xyz="0 0 0.058" rpy="0 0 0" />
    <parent link="base" />
    <child link="swivel_stage" />
    <axis xyz="0 0 1" />
    <limit effort="12" velocity="1.2" lower="-0.65" upper="0.65" />
    </joint>
  <joint name="swivel_to_mast" type="prismatic">
    <origin xyz="0 0 0.194" rpy="0 0 0" />
    <parent link="swivel_stage" />
    <child link="mast" />
    <axis xyz="0 0 1" />
    <limit effort="80" velocity="0.12" lower="0" upper="0.08" />
    </joint>
  <joint name="mast_to_tilt_head" type="revolute">
