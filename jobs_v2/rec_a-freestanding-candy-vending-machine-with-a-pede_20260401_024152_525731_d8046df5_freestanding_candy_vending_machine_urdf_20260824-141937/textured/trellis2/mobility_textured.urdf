		</visual>
		<visual name="machine_body__chute_side_right">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/machine_body__chute_side_right.glb" />
			</geometry>
		</visual>
		<visual name="machine_body__upper_collar">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/machine_body__upper_collar.glb" />
			</geometry>
		</visual>
		<visual name="machine_body__reservoir_shell">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/machine_body__reservoir_shell.glb" />
