			</geometry>
		</visual>
		<visual name="dispense_knob__finger_grip">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/dispense_knob__finger_grip.glb" />
			</geometry>
		</visual>
	</link>
	<joint name="knob_rotation" type="continuous">
		<origin xyz="0.152 0 0.998" rpy="0 0 0" />
		<parent link="machine_body" />
		<child link="dispense_knob" />
		<axis xyz="1 0 0" />
		<limit effort="4" velocity="10" />
	</joint>
</robot>