	</link>
	<link name="dispense_knob">
		<visual name="dispense_knob__axle">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/dispense_knob__axle.glb" />
			</geometry>
		</visual>
		<visual name="dispense_knob__wheel">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/dispense_knob__wheel.glb" />
			</geometry>
		</visual>
		<visual name="dispense_knob__finger_post">
