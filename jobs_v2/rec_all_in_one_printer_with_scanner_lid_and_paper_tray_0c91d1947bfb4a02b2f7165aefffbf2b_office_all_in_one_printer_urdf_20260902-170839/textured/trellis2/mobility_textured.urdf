			<origin xyz="0 0 0.0025" rpy="0 0 0" />
			<geometry>
				<box size="0.018 0.014 0.005" />
			</geometry>
		</collision>
		<visual name="button_0__button_cap">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/button_0__button_cap.glb" />
			</geometry>
		</visual>
	</link>
	<link name="button_1">
