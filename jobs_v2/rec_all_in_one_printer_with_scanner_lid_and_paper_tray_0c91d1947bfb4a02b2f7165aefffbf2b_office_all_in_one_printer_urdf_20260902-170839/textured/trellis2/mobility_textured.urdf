			<origin xyz="0 0 0.0025" rpy="0 0 0" />
			<geometry>
				<box size="0.018 0.014 0.005" />
			</geometry>
		</collision>
		<visual name="button_1__button_cap">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/button_1__button_cap.glb" />
			</geometry>
		</visual>
	</link>
	<link name="button_2">
		<collision name="button_cap">
			<origin xyz="0 0 0.0025" rpy="0 0 0" />
			<geometry>
				<box size="0.018 0.014 0.005" />
			</geometry>
		</collision>
		<visual name="button_2__button_cap">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/button_2__button_cap.glb" />
			</geometry>
		</visual>
	</link>
	<link name="button_3">
		<collision name="button_cap">
			<origin xyz="0 0 0.0025" rpy="0 0 0" />
			<geometry>
				<box size="0.018 0.014 0.005" />
			</geometry>
		</collision>
		<visual name="button_3__button_cap">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/button_3__button_cap.glb" />
			</geometry>
		</visual>
	</link>
	<link name="button_4">
		<collision name="button_cap">
			<origin xyz="0 0 0.0025" rpy="0 0 0" />
			<geometry>
				<box size="0.018 0.014 0.005" />
			</geometry>
		</collision>
		<visual name="button_4__button_cap">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/button_4__button_cap.glb" />
			</geometry>
		</visual>
	</link>
	<joint name="body_to_scanner_glass" type="fixed">
		<origin xyz="-0.075 -0.005 0.171" rpy="0 0 0" />
		<parent link="body" />
		<child link="scanner_glass" />
	</joint>
	<joint name="body_to_lid_mount" type="fixed">
		<origin xyz="-0.075 0.0985 0.185" rpy="0 0 0" />
		<parent link="body" />
		<child link="lid_mount" />
	</joint>
	<joint name="body_to_lid" type="revolute">
		<origin xyz="-0.075 0.1075 0.188" rpy="0 0 0" />
		<parent link="body" />
		<child link="lid" />
		<axis xyz="-1 0 0" />
		<limit effort="18" velocity="1.4" lower="0" upper="1.24" />
	</joint>
	<joint name="lid_to_adf_lid" type="revolute">
		<origin xyz="0 -0.035 0.054" rpy="0 0 0" />
		<parent link="lid" />
		<child link="adf_lid" />
		<axis xyz="-1 0 0" />
		<limit effort="8" velocity="1.5" lower="0" upper="1.1" />
	</joint>
	<joint name="body_to_cassette" type="prismatic">
		<origin xyz="0 -0.225 0.012" rpy="0 0 0" />
		<parent link="body" />
		<child link="cassette" />
		<axis xyz="0 -1 0" />
		<limit effort="70" velocity="0.18" lower="0" upper="0.13" />
	</joint>
	<joint name="body_to_tray_flap" type="revolute">
		<origin xyz="-0.01 -0.205 0.078" rpy="0 0 0" />
		<parent link="body" />
		<child link="tray_flap" />
		<axis xyz="1 0 0" />
		<limit effort="4" velocity="2.2" lower="0" upper="1.28" />
	</joint>
	<joint name="body_to_dial" type="continuous">
		<origin xyz="0.184 -0.112 0.205" rpy="0 0 0" />
		<parent link="body" />
		<child link="dial" />
		<axis xyz="0 0 1" />
		<limit effort="0.3" velocity="4" />
	</joint>
	<joint name="body_to_button_0" type="prismatic">
		<origin xyz="0.156 -0.149 0.205" rpy="0 0 0" />
		<parent link="body" />
		<child link="button_0" />
		<axis xyz="0 0 -1" />
		<limit effort="6" velocity="0.08" lower="0" upper="0.0025" />
	</joint>
	<joint name="body_to_button_1" type="prismatic">
		<origin xyz="0.184 -0.149 0.205" rpy="0 0 0" />
		<parent link="body" />
		<child link="button_1" />
		<axis xyz="0 0 -1" />
		<limit effort="6" velocity="0.08" lower="0" upper="0.0025" />
