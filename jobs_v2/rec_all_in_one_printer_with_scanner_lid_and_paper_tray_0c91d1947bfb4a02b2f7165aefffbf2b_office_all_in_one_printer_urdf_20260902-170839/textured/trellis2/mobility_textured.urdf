<?xml version='1.0' encoding='utf-8'?>
<robot name="office_all_in_one_printer">
	<material name="body_light">
		<color rgba="0.84 0.85 0.86 1" />
	</material>
	<material name="panel_dark">
		<color rgba="0.2 0.22 0.24 1" />
	</material>
	<material name="trim_mid">
		<color rgba="0.34 0.37 0.4 1" />
	</material>
	<material name="glass_blue">
		<color rgba="0.42 0.58 0.7 0.35" />
	</material>
	<material name="button_blue">
		<color rgba="0.22 0.31 0.42 1" />
	</material>
	<link name="body">
		<collision name="shell">
			<geometry>
				<mesh filename="assets/meshes/printer_body.obj" />
			</geometry>
		</collision>
		<visual name="body__shell">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/body__shell.glb" />
			</geometry>
		</visual>
	</link>
	<link name="scanner_glass">
		<collision name="glass">
			<origin xyz="0 0 0.0015" rpy="0 0 0" />
			<geometry>
				<box size="0.28 0.215 0.003" />
			</geometry>
		</collision>
		<visual name="scanner_glass__glass">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/scanner_glass__glass.glb" />
			</geometry>
		</visual>
	</link>
	<link name="lid_mount">
		<collision name="hinge_pad">
			<origin xyz="0 0 0.0015" rpy="0 0 0" />
			<geometry>
				<box size="0.296 0.018 0.003" />
			</geometry>
		</collision>
		<visual name="lid_mount__hinge_pad">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/lid_mount__hinge_pad.glb" />
			</geometry>
		</visual>
	</link>
	<link name="lid">
		<collision name="lid_shell">
			<geometry>
				<mesh filename="assets/meshes/printer_lid.obj" />
			</geometry>
		</collision>
		<visual name="lid__lid_shell">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/lid__lid_shell.glb" />
			</geometry>
		</visual>
	</link>
	<link name="adf_lid">
		<collision name="adf_shell">
			<geometry>
				<mesh filename="assets/meshes/printer_adf_lid.obj" />
			</geometry>
		</collision>
		<visual name="adf_lid__adf_shell">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/adf_lid__adf_shell.glb" />
			</geometry>
		</visual>
	</link>
	<link name="cassette">
		<collision name="tray_shell">
			<geometry>
				<mesh filename="assets/meshes/printer_cassette.obj" />
			</geometry>
		</collision>
		<visual name="cassette__tray_shell">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/cassette__tray_shell.glb" />
			</geometry>
		</visual>
	</link>
	<link name="tray_flap">
		<collision name="flap_panel">
			<geometry>
				<mesh filename="assets/meshes/printer_tray_flap.obj" />
			</geometry>
		</collision>
		<visual name="tray_flap__flap_panel">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/tray_flap__flap_panel.glb" />
			</geometry>
		</visual>
	</link>
	<link name="dial">
		<collision name="dial_knob">
			<origin xyz="0 0 0.006" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.017" length="0.012" />
			</geometry>
		</collision>
		<visual name="dial__dial_knob">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/dial__dial_knob.glb" />
			</geometry>
