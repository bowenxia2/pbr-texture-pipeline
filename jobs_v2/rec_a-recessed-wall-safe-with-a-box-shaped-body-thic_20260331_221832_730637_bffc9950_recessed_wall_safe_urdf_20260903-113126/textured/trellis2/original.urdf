  <joint name="body_to_door" type="revolute">
    <origin xyz="0.018 -0.17 0" rpy="0 0 0" />
    <parent link="body" />
    <child link="door" />
    <axis xyz="0 0 -1" />
    <limit effort="60" velocity="1.5" lower="0" upper="1.55" />
    </joint>
  <joint name="door_to_dial" type="continuous">
    <origin xyz="0.022 0.181 0.085" rpy="0 0 0" />
