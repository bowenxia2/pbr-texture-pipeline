	<joint name="handle_slide" type="prismatic">
		<origin xyz="0 0 0.308" rpy="0 0 0" />
		<parent link="base" />
		<child link="handle" />
		<axis xyz="0 0 1" />
		<limit effort="50" velocity="0.5" lower="0" upper="0.16" />
	</joint>
	<joint name="grip_roll" type="continuous">
		<origin xyz="0 0.07 0.125" rpy="0 0 0" />
		<parent link="handle" />
		<child link="grip" />
		<axis xyz="0 1 0" />
		<limit effort="2" velocity="8" />
	</joint>
	<joint name="gauge_sweep" type="revolute">
		<origin xyz="0.099 0 0.048" rpy="0 0 0" />
		<parent link="base" />
		<child link="needle" />
		<axis xyz="1 0 0" />
		<limit effort="0.2" velocity="6" lower="-1.2" upper="1.2" />
	</joint>
