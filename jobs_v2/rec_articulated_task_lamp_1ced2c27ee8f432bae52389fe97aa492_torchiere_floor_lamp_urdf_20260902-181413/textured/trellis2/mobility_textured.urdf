	<joint name="stand_to_main_shade" type="fixed">
		<origin xyz="0 0 1.665" rpy="0 0 0" />
		<parent link="stand" />
		<child link="main_shade" />
	</joint>
	<joint name="stand_to_reading_arm" type="revolute">
		<origin xyz="0.04 0 1.08" rpy="0 0 0" />
		<parent link="stand" />
		<child link="reading_arm" />
		<axis xyz="0 0 1" />
		<limit effort="6" velocity="1.4" lower="-2.15" upper="2.15" />
	</joint>
	<joint name="reading_arm_to_shade" type="revolute">
		<origin xyz="0.42 0 0.09" rpy="0 0 0" />
		<parent link="reading_arm" />
		<child link="reading_shade" />
		<axis xyz="0 1 0" />
		<limit effort="3" velocity="1.8" lower="-0.55" upper="1" />
	</joint>
</robot>