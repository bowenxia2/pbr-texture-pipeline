	</link>
	<link name="reading_arm">
		<inertial>
			<origin xyz="0.215 0 0.05" rpy="0 0 0" />
			<mass value="0.8" />
			<inertia ixx="0.00112667" ixy="0" ixz="0" iyy="0.0132867" iyz="0" izz="0.0124933" />
		</inertial>
		<visual name="reading_arm__root_knuckle">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/reading_arm__root_knuckle.glb" />
			</geometry>
