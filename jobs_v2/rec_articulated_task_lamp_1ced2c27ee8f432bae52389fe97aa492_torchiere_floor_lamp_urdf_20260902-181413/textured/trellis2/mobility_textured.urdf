		</visual>
		<visual name="stand__shoulder_collar">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/stand__shoulder_collar.glb" />
			</geometry>
		</visual>
		<visual name="stand__shoulder_boss">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/stand__shoulder_boss.glb" />
			</geometry>
		</visual>
		<visual name="stand__top_socket">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/stand__top_socket.glb" />
			</geometry>
		</visual>
	</link>
	<link name="main_shade">
		<inertial>
			<origin xyz="0 0 0.075" rpy="0 0 0" />
			<mass value="1.4" />
			<inertia ixx="0.0147117" ixy="0" ixz="0" iyy="0.0147117" iyz="0" izz="0.02268" />
		</inertial>
		<visual name="main_shade__main_bowl_shell">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/main_shade__main_bowl_shell.glb" />
			</geometry>
		</visual>
		<visual name="main_shade__mount_collar">
