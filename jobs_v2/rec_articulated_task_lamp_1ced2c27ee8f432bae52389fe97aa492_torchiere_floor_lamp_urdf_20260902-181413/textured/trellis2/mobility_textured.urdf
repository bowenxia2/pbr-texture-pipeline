			<geometry>
				<mesh filename="groups/reading_arm__arm_tube.glb" />
			</geometry>
		</visual>
		<visual name="reading_arm__tip_block">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/reading_arm__tip_block.glb" />
			</geometry>
		</visual>
	</link>
	<link name="reading_shade">
		<inertial>
			<origin xyz="0.06 0 0" rpy="0 1.5708 0" />
			<mass value="0.45" />
			<inertia ixx="0.00101839" ixy="0" ixz="0" iyy="0.00101839" iyz="0" izz="0.0008649" />
		</inertial>
		<visual name="reading_shade__hinge_barrel">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/reading_shade__hinge_barrel.glb" />
