	<joint name="wheel_0_spin" type="continuous">
		<origin xyz="-0.95 -0.365 0.115" rpy="0 0 0" />
		<parent link="frame" />
		<child link="wheel_0" />
		<axis xyz="0 1 0" />
		<limit effort="8" velocity="18" />
	</joint>
	<joint name="wheel_1_spin" type="continuous">
