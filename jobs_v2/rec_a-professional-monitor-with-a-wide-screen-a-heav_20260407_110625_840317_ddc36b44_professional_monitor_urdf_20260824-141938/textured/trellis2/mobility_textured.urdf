			<geometry>
				<mesh filename="groups/joystick__pivot_barrel.glb" />
			</geometry>
		</visual>
		<visual name="joystick__joystick_stem">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/joystick__joystick_stem.glb" />
