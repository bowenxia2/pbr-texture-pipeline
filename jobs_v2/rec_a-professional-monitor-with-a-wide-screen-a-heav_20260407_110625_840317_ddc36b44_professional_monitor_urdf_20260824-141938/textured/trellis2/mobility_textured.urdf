<?xml version='1.0' encoding='utf-8'?>
<robot name="professional_monitor">
	<material name="stand_dark">
		<color rgba="0.17 0.18 0.19 1" />
	</material>
	<material name="charcoal">
		<color rgba="0.22 0.23 0.24 1" />
	</material>
	<material name="housing_black">
		<color rgba="0.1 0.11 0.12 1" />
	</material>
	<material name="screen_black">
		<color rgba="0.03 0.04 0.05 1" />
	</material>
	<material name="joystick_dark">
		<color rgba="0.12 0.12 0.12 1" />
	</material>
	<link name="pedestal">
		<inertial>
			<origin xyz="0 0 0.035" rpy="0 0 0" />
			<mass value="6.8" />
			<inertia ixx="0.0327533" ixy="0" ixz="0" iyy="0.0504333" iyz="0" izz="0.0776333" />
		</inertial>
		<visual name="pedestal__base_plate">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
