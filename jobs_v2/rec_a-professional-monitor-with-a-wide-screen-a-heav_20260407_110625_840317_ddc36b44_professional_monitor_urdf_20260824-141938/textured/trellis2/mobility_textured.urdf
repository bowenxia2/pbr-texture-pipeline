	<joint name="pedestal_to_stand_swivel" type="revolute">
		<origin xyz="0 0 0.07" rpy="0 0 0" />
		<parent link="pedestal" />
		<child link="stand" />
		<axis xyz="0 0 1" />
		<limit effort="35" velocity="1.6" lower="-0.959931" upper="0.959931" />
	</joint>
	<joint name="stand_to_display_tilt" type="revolute">
		<origin xyz="0 -0.026 0.338" rpy="0 0 0" />
		<parent link="stand" />
		<child link="display" />
		<axis xyz="-1 0 0" />
		<limit effort="12" velocity="1.2" lower="-0.0872665" upper="0.383972" />
	</joint>
	<joint name="display_to_joystick" type="revolute">
		<origin xyz="0.128 0 -0.155" rpy="0 0 0" />
		<parent link="display" />
		<child link="joystick" />
		<axis xyz="1 0 0" />
		<limit effort="0.5" velocity="4" lower="-0.35" upper="0.35" />
	</joint>
</robot>