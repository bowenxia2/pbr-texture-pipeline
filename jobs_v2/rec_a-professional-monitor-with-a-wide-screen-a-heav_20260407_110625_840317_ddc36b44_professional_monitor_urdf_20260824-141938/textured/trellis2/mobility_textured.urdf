			</geometry>
		</visual>
		<visual name="pedestal__pedestal_collar">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/pedestal__pedestal_collar.glb" />
			</geometry>
		</visual>
	</link>
	<link name="stand">
		<inertial>
			<origin xyz="0 -0.008 0.175" rpy="0 0 0" />
			<mass value="2.4" />
			<inertia ixx="0.02578" ixy="0" ixz="0" iyy="0.02962" iyz="0" izz="0.0064" />
		</inertial>
		<visual name="stand__rotating_collar">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/stand__rotating_collar.glb" />
			</geometry>
		</visual>
		<visual name="stand__upright_column">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/stand__upright_column.glb" />
			</geometry>
		</visual>
		<visual name="stand__head_bridge">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/stand__head_bridge.glb" />
			</geometry>
		</visual>
		<visual name="stand__hinge_barrel">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/stand__hinge_barrel.glb" />
			</geometry>
		</visual>
	</link>
	<link name="display">
		<inertial>
			<origin xyz="0 -0.02 0" rpy="0 0 0" />
			<mass value="4.9" />
			<inertia ixx="0.0599842" ixy="0" ixz="0" iyy="0.215927" iyz="0" izz="0.157984" />
		</inertial>
		<visual name="display__display_shell">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/display__display_shell.glb" />
			</geometry>
		</visual>
		<visual name="display__screen_glass">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/display__screen_glass.glb" />
			</geometry>
		</visual>
		<visual name="display__rear_bulge">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/display__rear_bulge.glb" />
			</geometry>
		</visual>
		<visual name="display__rear_mount_plate">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/display__rear_mount_plate.glb" />
			</geometry>
		</visual>
		<visual name="display__joystick_support">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/display__joystick_support.glb" />
			</geometry>
