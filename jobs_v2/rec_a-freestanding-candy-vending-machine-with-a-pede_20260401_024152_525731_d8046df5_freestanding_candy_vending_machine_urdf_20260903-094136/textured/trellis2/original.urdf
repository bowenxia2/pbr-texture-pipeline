<robot name="freestanding_candy_vending_machine">
  <material name="pedestal_black">
    <color rgba="0.14 0.14 0.15 1" />
    </material>
  <material name="enamel_red">
    <color rgba="0.7 0.07 0.1 1" />
    </material>
  <material name="chrome">
    <color rgba="0.76 0.78 0.82 1" />
    </material>
  <material name="clear_acrylic">
    <color rgba="0.77 0.9 0.98 0.28" />
    </material>
  <material name="grip_black">
    <color rgba="0.08 0.08 0.09 1" />
    </material>
  <link name="machine_body">
    <visual name="pedestal_foot">
      <geometry>
        <mesh filename="assets/meshes/pedestal_foot.obj" />
        </geometry>
      <material name="pedestal_black">
        <color rgba="0.14 0.14 0.15 1" />
        </material>
      </visual>
    <visual name="pedestal_column">
      <origin xyz="0 0 0.45" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.055" length="0.72" />
        </geometry>
      <material name="pedestal_black">
        <color rgba="0.14 0.14 0.15 1" />
        </material>
      </visual>
    <visual name="lower_collar">
      <origin xyz="0 0 0.85" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.08" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="coin_box_shell">
      <origin xyz="0 0 1" rpy="0 0 0" />
      <geometry>
        <box size="0.28 0.24 0.22" />
        </geometry>
      <material name="enamel_red">
        <color rgba="0.7 0.07 0.1 1" />
        </material>
      </visual>
    <visual name="front_service_plate">
      <origin xyz="0.146 0 1.01" rpy="0 0 0" />
      <geometry>
        <box size="0.012 0.18 0.16" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="coin_slot">
      <origin xyz="0.148 0 1.075" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.086 0.02" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="knob_bezel">
      <origin xyz="0.146 0 0.998" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.048" length="0.012" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="chute_floor">
      <origin xyz="0.2 0 0.894" rpy="0 0 0" />
      <geometry>
        <box size="0.12 0.09 0.012" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="chute_roof">
      <origin xyz="0.1825 0 0.94" rpy="0 0 0" />
      <geometry>
        <box size="0.085 0.09 0.012" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="chute_side_left">
      <origin xyz="0.1825 0.04 0.917" rpy="0 0 0" />
      <geometry>
        <box size="0.085 0.01 0.056" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="chute_side_right">
      <origin xyz="0.1825 -0.04 0.917" rpy="0 0 0" />
      <geometry>
        <box size="0.085 0.01 0.056" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="upper_collar">
      <origin xyz="0 0 1.14" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.092" length="0.06" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="reservoir_shell">
      <origin xyz="0 0 1.17" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/reservoir_shell.obj" />
        </geometry>
      <material name="clear_acrylic">
        <color rgba="0.77 0.9 0.98 0.28" />
        </material>
      </visual>
    <visual name="lid">
      <origin xyz="0 0 1.479" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.092" length="0.018" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="lid_cap">
      <origin xyz="0 0 1.5" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.024" length="0.024" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    </link>
  <link name="dispense_knob">
    <visual name="axle">
      <origin xyz="0.009 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.012" length="0.018" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="wheel">
      <origin xyz="0.0245 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.04" length="0.013" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="finger_post">
      <origin xyz="0.041 0.028 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.008" length="0.02" />
        </geometry>
      <material name="chrome">
        <color rgba="0.76 0.78 0.82 1" />
        </material>
      </visual>
    <visual name="finger_grip">
      <origin xyz="0.051 0.028 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.009" />
        </geometry>
      <material name="grip_black">
        <color rgba="0.08 0.08 0.09 1" />
        </material>
      </visual>
    </link>
  <joint name="knob_rotation" type="continuous">
    <origin xyz="0.152 0 0.998" rpy="0 0 0" />
    <parent link="machine_body" />
    <child link="dispense_knob" />
    <axis xyz="1 0 0" />
    <limit effort="4" velocity="10" />
    </joint>
  </robot>
