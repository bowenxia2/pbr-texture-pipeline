<?xml version='1.0' encoding='utf-8'?>
<robot name="tower_crane">
	<material name="concrete">
		<color rgba="0.64 0.64 0.61 1" />
	</material>
	<material name="safety_yellow">
		<color rgba="0.9 0.74 0.16 1" />
	</material>
	<material name="painted_steel">
		<color rgba="0.57 0.59 0.62 1" />
	</material>
	<material name="dark_steel">
		<color rgba="0.25 0.27 0.3 1" />
	</material>
	<material name="rope_black">
		<color rgba="0.12 0.12 0.13 1" />
	</material>
	<material name="cab_glass">
		<color rgba="0.62 0.77 0.85 0.42" />
	</material>
	<link name="base">
		<inertial>
			<origin xyz="0 0 3.46" rpy="0 0 0" />
			<mass value="6800" />
			<inertia ixx="31578.3" ixy="0" ixz="0" iyy="31578.3" iyz="0" izz="8885.33" />
		</inertial>
		<visual name="base">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/base.glb" />
			</geometry>
		</visual>
	</link>
	<link name="upperworks">
		<inertial>
			<origin xyz="1.88 0 0.68" rpy="0 0 0" />
			<mass value="1680" />
			<inertia ixx="890.75" ixy="0" ixz="0" iyy="10061.1" iyz="0" izz="9887.15" />
		</inertial>
		<visual name="upperworks">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/upperworks.glb" />
			</geometry>
		</visual>
	</link>
	<link name="counterweight">
		<inertial>
			<origin xyz="-0.24 0 0.28" rpy="0 0 0" />
			<mass value="1850" />
			<inertia ixx="202.513" ixy="0" ixz="0" iyy="167.733" iyz="0" izz="273.553" />
		</inertial>
		<visual name="counterweight">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/counterweight.glb" />
			</geometry>
		</visual>
	</link>
	<link name="trolley">
		<inertial>
			<origin xyz="0 0 -0.12" rpy="0 0 0" />
			<mass value="260" />
			<inertia ixx="5.31267" ixy="0" ixz="0" iyy="8.36333" iyz="0" izz="8.66667" />
		</inertial>
		<visual name="trolley">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/trolley.glb" />
			</geometry>
		</visual>
	</link>
	<link name="hook_block">
		<inertial>
			<origin xyz="0 0 -1.4" rpy="0 0 0" />
			<mass value="180" />
			<inertia ixx="118.2" ixy="0" ixz="0" iyy="118.776" iyz="0" izz="1.776" />
		</inertial>
		<visual name="hook_block">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/hook_block.glb" />
			</geometry>
		</visual>
	</link>
	<joint name="slew_rotation" type="continuous">
		<origin xyz="0 0 6.89" rpy="0 0 0" />
		<parent link="base" />
		<child link="upperworks" />
		<axis xyz="0 0 1" />
		<limit effort="35000" velocity="0.45" />
	</joint>
	<joint name="jib_trolley" type="prismatic">
		<origin xyz="0.96 0 0.32" rpy="0 0 0" />
		<parent link="upperworks" />
		<child link="trolley" />
		<axis xyz="1 0 0" />
		<limit effort="12000" velocity="0.9" lower="0" upper="3.96" />
	</joint>
	<joint name="upperworks_to_counterweight" type="fixed">
		<origin xyz="-1.52 0 0.32" rpy="0 0 0" />
		<parent link="upperworks" />
		<child link="counterweight" />
	</joint>
	<joint name="trolley_to_hook" type="fixed">
		<origin xyz="0 0 -0.16" rpy="0 0 0" />
		<parent link="trolley" />
		<child link="hook_block" />
	</joint>
</robot>