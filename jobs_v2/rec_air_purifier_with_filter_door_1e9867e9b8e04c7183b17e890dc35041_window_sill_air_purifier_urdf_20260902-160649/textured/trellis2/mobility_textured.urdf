	<joint name="housing_to_lid" type="revolute">
		<origin xyz="0 0.124 0.155" rpy="0 0 0" />
		<parent link="housing" />
		<child link="lid" />
		<axis xyz="-1 0 0" />
		<limit effort="8" velocity="2" lower="0" upper="1.25" />
	</joint>
	<joint name="housing_to_pre_filter" type="prismatic">
		<origin xyz="0 -0.12 0.095" rpy="0 0 0" />
