	<joint name="body_to_handle" type="prismatic">
		<origin xyz="0 0 0.9" rpy="0 0 0" />
		<parent link="body" />
		<child link="handle" />
		<axis xyz="0 0 1" />
		<limit effort="180" velocity="0.35" lower="0" upper="0.25" />
	</joint>
	<joint name="handle_to_grip" type="continuous">
		<origin xyz="0.13 0 0.62" rpy="0 0 0" />
		<parent link="handle" />
		<child link="grip" />
		<axis xyz="1 0 0" />
		<limit effort="2" velocity="6" />
	</joint>
	<joint name="body_to_needle" type="continuous">
		<origin xyz="0 -0.161 0.52" rpy="0 0 0" />
		<parent link="body" />
		<child link="needle" />
		<axis xyz="0 -1 0" />
		<limit effort="0.05" velocity="20" />
	</joint>
</robot>