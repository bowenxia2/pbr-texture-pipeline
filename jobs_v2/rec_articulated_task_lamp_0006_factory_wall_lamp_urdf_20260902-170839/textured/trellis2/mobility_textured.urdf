	<joint name="shoulder_swing" type="revolute">
		<origin xyz="0.016 0 0" rpy="0 0 0" />
		<parent link="bracket" />
		<child link="boom" />
		<axis xyz="0 0 1" />
		<limit effort="12" velocity="1.8" lower="-1.05" upper="1.05" />
	</joint>
	<joint name="head_tilt" type="revolute">
		<origin xyz="0.332 0 0" rpy="0 0 0" />
		<parent link="boom" />
		<child link="head" />
		<axis xyz="0 1 0" />
		<limit effort="6" velocity="2" lower="-0.28" upper="0.55" />
	</joint>
