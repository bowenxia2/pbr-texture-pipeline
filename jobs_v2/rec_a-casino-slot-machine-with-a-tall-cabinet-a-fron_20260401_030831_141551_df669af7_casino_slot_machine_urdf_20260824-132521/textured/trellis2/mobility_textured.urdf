		<child link="coin_tray" />
	</joint>
	<joint name="cabinet_to_pull_handle" type="revolute">
		<origin xyz="0.378 0.02 0.94" rpy="0 0 0" />
		<parent link="cabinet" />
		<child link="pull_handle" />
		<axis xyz="0 1 0" />
		<limit effort="18" velocity="2" lower="0" upper="1.05" />
	</joint>
