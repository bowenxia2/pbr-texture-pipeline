	<joint name="bracket_to_housing" type="fixed">
		<parent link="wall_bracket" />
		<child link="housing" />
	</joint>
	<joint name="housing_to_cover" type="revolute">
		<origin xyz="-0.243 0.119 0" rpy="0 0 0" />
		<parent link="housing" />
		<child link="front_cover" />
		<axis xyz="0 0 1" />
		<limit effort="8" velocity="1.2" lower="0" upper="1.75" />
	</joint>
	<joint name="housing_to_filter" type="prismatic">
		<origin xyz="0 0.067 0" rpy="0 0 0" />
		<parent link="housing" />
		<child link="filter_cartridge" />
		<axis xyz="0 1 0" />
		<limit effort="18" velocity="0.2" lower="0" upper="0.12" />
	</joint>
