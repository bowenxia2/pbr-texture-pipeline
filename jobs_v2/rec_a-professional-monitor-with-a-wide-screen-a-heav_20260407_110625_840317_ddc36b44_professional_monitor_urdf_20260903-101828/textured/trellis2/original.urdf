<robot name="professional_monitor">
  <material name="stand_dark">
    <color rgba="0.17 0.18 0.19 1" />
    </material>
  <material name="charcoal">
    <color rgba="0.22 0.23 0.24 1" />
    </material>
  <material name="housing_black">
    <color rgba="0.1 0.11 0.12 1" />
    </material>
  <material name="screen_black">
    <color rgba="0.03 0.04 0.05 1" />
    </material>
  <material name="joystick_dark">
    <color rgba="0.12 0.12 0.12 1" />
    </material>
  <link name="pedestal">
    <inertial>
      <origin xyz="0 0 0.035" rpy="0 0 0" />
      <mass value="6.8" />
      <inertia ixx="0.0327533" ixy="0" ixz="0" iyy="0.0504333" iyz="0" izz="0.0776333" />
      </inertial>
    <visual name="base_plate">
      <origin xyz="0 0 0.009" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/monitor_base_plate.obj" />
        </geometry>
      <material name="stand_dark">
        <color rgba="0.17 0.18 0.19 1" />
        </material>
      </visual>
    <visual name="pedestal_stem">
      <origin xyz="0 0 0.032" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.028" length="0.028" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.24 1" />
        </material>
      </visual>
    <visual name="pedestal_collar">
      <origin xyz="0 0 0.058" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.046" length="0.024" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.24 1" />
        </material>
      </visual>
    </link>
  <link name="stand">
    <inertial>
      <origin xyz="0 -0.008 0.175" rpy="0 0 0" />
      <mass value="2.4" />
      <inertia ixx="0.02578" ixy="0" ixz="0" iyy="0.02962" iyz="0" izz="0.0064" />
      </inertial>
    <visual name="rotating_collar">
      <origin xyz="0 0 0.008" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.042" length="0.016" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.24 1" />
        </material>
      </visual>
    <visual name="upright_column">
      <geometry>
        <mesh filename="assets/meshes/monitor_column.obj" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.24 1" />
        </material>
      </visual>
    <visual name="head_bridge">
      <origin xyz="0 -0.012 0.338" rpy="0 0 0" />
      <geometry>
        <box size="0.074 0.024 0.03" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.24 1" />
        </material>
      </visual>
    <visual name="hinge_barrel">
      <origin xyz="0 -0.026 0.338" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.008" length="0.16" />
        </geometry>
      <material name="stand_dark">
        <color rgba="0.17 0.18 0.19 1" />
        </material>
      </visual>
    </link>
  <link name="display">
    <inertial>
      <origin xyz="0 -0.02 0" rpy="0 0 0" />
      <mass value="4.9" />
      <inertia ixx="0.0599842" ixy="0" ixz="0" iyy="0.215927" iyz="0" izz="0.157984" />
      </inertial>
    <visual name="display_shell">
      <geometry>
        <mesh filename="assets/meshes/monitor_display_shell.obj" />
        </geometry>
      <material name="housing_black">
        <color rgba="0.1 0.11 0.12 1" />
        </material>
      </visual>
    <visual name="screen_glass">
      <origin xyz="0 -0.03 0" rpy="0 0 0" />
      <geometry>
        <box size="0.592 0.004 0.334" />
        </geometry>
      <material name="screen_black">
        <color rgba="0.03 0.04 0.05 1" />
        </material>
      </visual>
    <visual name="rear_bulge">
      <origin xyz="0 -0.017 0" rpy="0 0 0" />
      <geometry>
        <box size="0.226 0.018 0.154" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.24 1" />
        </material>
      </visual>
    <visual name="rear_mount_plate">
      <origin xyz="0 -0.016 0" rpy="0 0 0" />
      <geometry>
        <box size="0.124 0.016 0.072" />
        </geometry>
      <material name="stand_dark">
        <color rgba="0.17 0.18 0.19 1" />
        </material>
      </visual>
    <visual name="joystick_support">
      <origin xyz="0.128 -0.006 -0.155" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.012 0.012" />
        </geometry>
      <material name="stand_dark">
        <color rgba="0.17 0.18 0.19 1" />
        </material>
      </visual>
    </link>
  <link name="joystick">
    <inertial>
      <origin xyz="0 0.012 -0.004" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="2.33e-06" ixy="0" ixz="0" iyy="1.13e-06" iyz="0" izz="2.18e-06" />
      </inertial>
    <visual name="pivot_barrel">
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0045" length="0.014" />
        </geometry>
      <material name="joystick_dark">
        <color rgba="0.12 0.12 0.12 1" />
        </material>
      </visual>
    <visual name="joystick_stem">
      <origin xyz="0 0.01 -0.005" rpy="-1.5708 0 0" />
      <geometry>
        <cylinder radius="0.003" length="0.014" />
        </geometry>
      <material name="joystick_dark">
        <color rgba="0.12 0.12 0.12 1" />
        </material>
      </visual>
    <visual name="joystick_cap">
      <origin xyz="0 0.018 -0.008" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.005" />
        </geometry>
      <material name="joystick_dark">
        <color rgba="0.12 0.12 0.12 1" />
        </material>
      </visual>
    </link>
  <joint name="pedestal_to_stand_swivel" type="revolute">
    <origin xyz="0 0 0.07" rpy="0 0 0" />
    <parent link="pedestal" />
    <child link="stand" />
    <axis xyz="0 0 1" />
    <limit effort="35" velocity="1.6" lower="-0.959931" upper="0.959931" />
    </joint>
  <joint name="stand_to_display_tilt" type="revolute">
    <origin xyz="0 -0.026 0.338" rpy="0 0 0" />
    <parent link="stand" />
    <child link="display" />
    <axis xyz="-1 0 0" />
    <limit effort="12" velocity="1.2" lower="-0.0872665" upper="0.383972" />
    </joint>
  <joint name="display_to_joystick" type="revolute">
    <origin xyz="0.128 0 -0.155" rpy="0 0 0" />
    <parent link="display" />
    <child link="joystick" />
    <axis xyz="1 0 0" />
    <limit effort="0.5" velocity="4" lower="-0.35" upper="0.35" />
    </joint>
  </robot>
