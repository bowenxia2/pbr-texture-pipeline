        </geometry>
      <material name="frame_gray">
        <color rgba="0.25 0.28 0.31 1" />
        </material>
      </visual>
    <visual name="top_rail">
      <origin xyz="0 0 0.058" rpy="0 0 0" />
      <geometry>
        <box size="0.154 0.1 0.014" />
        </geometry>
      <material name="frame_gray">
        <color rgba="0.25 0.28 0.31 1" />
        </material>
      </visual>
    <visual name="bottom_rail">
      <origin xyz="0 0 -0.058" rpy="0 0 0" />
      <geometry>
        <box size="0.154 0.1 0.014" />
        </geometry>
      <material name="frame_gray">
        <color rgba="0.25 0.28 0.31 1" />
        </material>
      </visual>
    </link>
  <link name="left_bearing_cartridge">
    <inertial>
      <mass value="0.22" />
      <inertia ixx="0.000150187" ixy="0" ixz="0" iyy="8.39667e-05" iyz="0" izz="8.39667e-05" />
      </inertial>
    <visual name="housing">
      <geometry>
        <mesh filename="assets/meshes/bearing_cartridge.obj" />
        </geometry>
      <material name="cartridge_aluminum">
        <color rgba="0.74 0.76 0.8 1" />
        </material>
      </visual>
    </link>
  <link name="right_bearing_cartridge">
    <inertial>
      <mass value="0.22" />
      <inertia ixx="0.000150187" ixy="0" ixz="0" iyy="8.39667e-05" iyz="0" izz="8.39667e-05" />
      </inertial>
    <visual name="housing">
      <geometry>
        <mesh filename="assets/meshes/bearing_cartridge.obj" />
        </geometry>
      <material name="cartridge_aluminum">
        <color rgba="0.74 0.76 0.8 1" />
        </material>
      </visual>
    </link>
  <link name="shaft">
    <inertial>
      <mass value="0.68" />
      <inertia ixx="8.88533e-05" ixy="0" ixz="0" iyy="0.00160593" iyz="0" izz="0.00160593" />
      </inertial>
    <visual name="left_journal">
      <origin xyz="-0.066 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0085" length="0.022" />
        </geometry>
      <material name="shaft_steel">
        <color rgba="0.62 0.65 0.69 1" />
        </material>
      </visual>
    <visual name="right_journal">
      <origin xyz="0.066 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0085" length="0.022" />
        </geometry>
      <material name="shaft_steel">
        <color rgba="0.62 0.65 0.69 1" />
        </material>
      </visual>
    <visual name="left_shoulder">
      <origin xyz="-0.053 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0135" length="0.004" />
        </geometry>
      <material name="shaft_steel">
        <color rgba="0.62 0.65 0.69 1" />
        </material>
      </visual>
    <visual name="right_shoulder">
      <origin xyz="0.053 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0135" length="0.004" />
        </geometry>
      <material name="shaft_steel">
        <color rgba="0.62 0.65 0.69 1" />
        </material>
      </visual>
    <visual name="main_shaft">
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.01" length="0.11" />
        </geometry>
      <material name="shaft_steel">
        <color rgba="0.62 0.65 0.69 1" />
        </material>
      </visual>
    <visual name="center_hub">
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.013" length="0.044" />
        </geometry>
      <material name="shaft_steel">
        <color rgba="0.62 0.65 0.69 1" />
        </material>
      </visual>
    <visual name="mount_pad">
      <origin xyz="0 0 0.013" rpy="0 0 0" />
      <geometry>
        <box size="0.028 0.022 0.004" />
        </geometry>
      <material name="shaft_steel">
        <color rgba="0.62 0.65 0.69 1" />
        </material>
      </visual>
    </link>
  <link name="payload_bracket">
    <inertial>
      <origin xyz="0 0 0.012" rpy="0 0 0" />
      <mass value="0.18" />
      <inertia ixx="2.6115e-05" ixy="0" ixz="0" iyy="2.2755e-05" iyz="0" izz="2.364e-05" />
      </inertial>
    <visual name="clamp_block">
      <geometry>
        <mesh filename="assets/meshes/payload_clamp_block.obj" />
        </geometry>
      <material name="bracket_black">
        <color rgba="0.16 0.17 0.19 1" />
        </material>
      </visual>
    <visual name="web_rib">
      <origin xyz="0 0 0.0125" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/payload_web_rib.obj" />
        </geometry>
      <material name="bracket_black">
        <color rgba="0.16 0.17 0.19 1" />
        </material>
      </visual>
    <visual name="top_plate">
      <origin xyz="0 0 0.0245" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/payload_top_plate.obj" />
        </geometry>
      <material name="bracket_black">
        <color rgba="0.16 0.17 0.19 1" />
        </material>
      </visual>
    </link>
  <joint name="frame_to_left_bearing" type="fixed">
    <origin xyz="-0.066 0 0" rpy="0 0 0" />
    <parent link="support_frame" />
    <child link="left_bearing_cartridge" />
    </joint>
  <joint name="frame_to_right_bearing" type="fixed">
    <origin xyz="0.066 0 0" rpy="0 0 0" />
    <parent link="support_frame" />
    <child link="right_bearing_cartridge" />
    </joint>
  <joint name="frame_to_shaft_roll" type="revolute">
    <parent link="support_frame" />
    <child link="shaft" />
    <axis xyz="1 0 0" />
    <limit effort="12" velocity="3" lower="-3.14159" upper="3.14159" />
    </joint>
  <joint name="shaft_to_payload_bracket" type="fixed">
    <origin xyz="0 0 0.0175" rpy="0 0 0" />
    <parent link="shaft" />
    <child link="payload_bracket" />
    </joint>
  </robot>
