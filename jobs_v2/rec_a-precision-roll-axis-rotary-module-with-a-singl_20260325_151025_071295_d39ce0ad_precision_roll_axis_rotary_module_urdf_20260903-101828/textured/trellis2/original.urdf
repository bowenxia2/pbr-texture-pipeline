<robot name="precision_roll_axis_rotary_module">
  <material name="frame_gray">
    <color rgba="0.25 0.28 0.31 1" />
    </material>
  <material name="cartridge_aluminum">
    <color rgba="0.74 0.76 0.8 1" />
    </material>
  <material name="shaft_steel">
    <color rgba="0.62 0.65 0.69 1" />
    </material>
  <material name="bracket_black">
    <color rgba="0.16 0.17 0.19 1" />
    </material>
  <link name="support_frame">
    <inertial>
      <mass value="3.4" />
      <inertia ixx="0.00762167" ixy="0" ixz="0" iyy="0.0145905" iyz="0" izz="0.0126355" />
      </inertial>
    <visual name="left_plate">
