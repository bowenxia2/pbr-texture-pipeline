<?xml version='1.0' encoding='utf-8'?>
<robot name="precision_roll_axis_rotary_module">
	<material name="frame_gray">
		<color rgba="0.25 0.28 0.31 1" />
	</material>
	<material name="cartridge_aluminum">
		<color rgba="0.74 0.76 0.8 1" />
	</material>
	<material name="shaft_steel">
		<color rgba="0.62 0.65 0.69 1" />
	</material>
	<material name="bracket_black">
		<color rgba="0.16 0.17 0.19 1" />
	</material>
	<link name="support_frame">
		<inertial>
			<mass value="3.4" />
			<inertia ixx="0.00762167" ixy="0" ixz="0" iyy="0.0145905" iyz="0" izz="0.0126355" />
		</inertial>
		<visual name="support_frame__left_plate">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/support_frame__left_plate.glb" />
			</geometry>
		</visual>
		<visual name="support_frame__right_plate">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/support_frame__right_plate.glb" />
			</geometry>
		</visual>
		<visual name="support_frame__top_rail">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/support_frame__top_rail.glb" />
			</geometry>
		</visual>
		<visual name="support_frame__bottom_rail">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/support_frame__bottom_rail.glb" />
			</geometry>
		</visual>
	</link>
	<link name="left_bearing_cartridge">
		<inertial>
			<mass value="0.22" />
			<inertia ixx="0.000150187" ixy="0" ixz="0" iyy="8.39667e-05" iyz="0" izz="8.39667e-05" />
		</inertial>
		<visual name="left_bearing_cartridge__housing">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/left_bearing_cartridge__housing.glb" />
			</geometry>
		</visual>
	</link>
	<link name="right_bearing_cartridge">
		<inertial>
			<mass value="0.22" />
			<inertia ixx="0.000150187" ixy="0" ixz="0" iyy="8.39667e-05" iyz="0" izz="8.39667e-05" />
		</inertial>
		<visual name="right_bearing_cartridge__housing">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/right_bearing_cartridge__housing.glb" />
			</geometry>
		</visual>
	</link>
	<link name="shaft">
		<inertial>
			<mass value="0.68" />
			<inertia ixx="8.88533e-05" ixy="0" ixz="0" iyy="0.00160593" iyz="0" izz="0.00160593" />
		</inertial>
		<visual name="shaft__left_journal">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/shaft__left_journal.glb" />
			</geometry>
		</visual>
		<visual name="shaft__right_journal">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/shaft__right_journal.glb" />
			</geometry>
		</visual>
		<visual name="shaft__left_shoulder">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/shaft__left_shoulder.glb" />
			</geometry>
		</visual>
		<visual name="shaft__right_shoulder">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/shaft__right_shoulder.glb" />
			</geometry>
		</visual>
		<visual name="shaft__main_shaft">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/shaft__main_shaft.glb" />
			</geometry>
		</visual>
		<visual name="shaft__center_hub">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/shaft__center_hub.glb" />
			</geometry>
		</visual>
		<visual name="shaft__mount_pad">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/shaft__mount_pad.glb" />
			</geometry>
		</visual>
	</link>
	<link name="payload_bracket">
		<inertial>
			<origin xyz="0 0 0.012" rpy="0 0 0" />
			<mass value="0.18" />
			<inertia ixx="2.6115e-05" ixy="0" ixz="0" iyy="2.2755e-05" iyz="0" izz="2.364e-05" />
		</inertial>
		<visual name="payload_bracket__clamp_block">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/payload_bracket__clamp_block.glb" />
			</geometry>
		</visual>
		<visual name="payload_bracket__web_rib">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/payload_bracket__web_rib.glb" />
			</geometry>
		</visual>
		<visual name="payload_bracket__top_plate">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/payload_bracket__top_plate.glb" />
			</geometry>
		</visual>
	</link>
	<joint name="frame_to_left_bearing" type="fixed">
		<origin xyz="-0.066 0 0" rpy="0 0 0" />
		<parent link="support_frame" />
		<child link="left_bearing_cartridge" />
	</joint>
	<joint name="frame_to_right_bearing" type="fixed">
		<origin xyz="0.066 0 0" rpy="0 0 0" />
		<parent link="support_frame" />
		<child link="right_bearing_cartridge" />
	</joint>
	<joint name="frame_to_shaft_roll" type="revolute">
		<parent link="support_frame" />
		<child link="shaft" />
		<axis xyz="1 0 0" />
		<limit effort="12" velocity="3" lower="-3.14159" upper="3.14159" />
	</joint>
	<joint name="shaft_to_payload_bracket" type="fixed">
		<origin xyz="0 0 0.0175" rpy="0 0 0" />
		<parent link="shaft" />
		<child link="payload_bracket" />
	</joint>
</robot>