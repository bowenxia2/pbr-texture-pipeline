<?xml version='1.0' encoding='utf-8'?>
<robot name="tower_crane">
	<material name="crane_yellow">
		<color rgba="0.92 0.74 0.12 1" />
	</material>
	<material name="dark_steel">
		<color rgba="0.24 0.26 0.29 1" />
	</material>
	<material name="light_steel">
		<color rgba="0.62 0.66 0.69 1" />
	</material>
	<material name="ballast_gray">
		<color rgba="0.4 0.41 0.44 1" />
	</material>
	<material name="concrete">
		<color rgba="0.65 0.65 0.63 1" />
	</material>
	<material name="cable_black">
		<color rgba="0.08 0.08 0.09 1" />
	</material>
	<material name="cab_glass">
		<color rgba="0.68 0.8 0.88 0.42" />
	</material>
	<link name="mast">
		<inertial>
			<origin xyz="0 0 0.79" rpy="0 0 0" />
			<mass value="95" />
			<inertia ixx="22.8063" ixy="0" ixz="0" iyy="22.8063" iyz="0" izz="6.08633" />
		</inertial>
		<visual name="mast">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/mast.glb" />
			</geometry>
		</visual>
	</link>
	<link name="upperworks">
		<inertial>
			<origin xyz="0.42 0 0.22" rpy="0 0 0" />
			<mass value="42" />
			<inertia ixx="1.61875" ixy="0" ixz="0" iyy="19.5737" iyz="0" izz="19.075" />
		</inertial>
		<visual name="upperworks">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/upperworks.glb" />
			</geometry>
		</visual>
	</link>
	<link name="trolley">
		<inertial>
			<origin xyz="0 0 0.06" rpy="0 0 0" />
			<mass value="4" />
			<inertia ixx="0.0133333" ixy="0" ixz="0" iyy="0.0113333" iyz="0" izz="0.0150667" />
		</inertial>
		<visual name="trolley">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/trolley.glb" />
			</geometry>
		</visual>
	</link>
	<link name="hook_block">
		<inertial>
			<origin xyz="0 0 -0.42" rpy="0 0 0" />
			<mass value="3.5" />
			<inertia ixx="0.207667" ixy="0" ixz="0" iyy="0.21" iyz="0" izz="0.00606667" />
		</inertial>
		<visual name="hook_block">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/hook_block.glb" />
			</geometry>
		</visual>
	</link>
	<joint name="slew_ring" type="continuous">
		<origin xyz="0 0 1.52" rpy="0 0 0" />
		<parent link="mast" />
		<child link="upperworks" />
		<axis xyz="0 0 1" />
		<limit effort="160" velocity="0.8" />
	</joint>
	<joint name="trolley_on_jib" type="prismatic">
		<origin xyz="0.32 0 0.152" rpy="0 0 0" />
		<parent link="upperworks" />
		<child link="trolley" />
		<axis xyz="1 0 0" />
		<limit effort="25" velocity="0.7" lower="-0.08" upper="1" />
	</joint>
	<joint name="trolley_to_hook" type="fixed">
		<origin xyz="0 0 -0.03" rpy="0 0 0" />
		<parent link="trolley" />
		<child link="hook_block" />
	</joint>
</robot>