  <joint name="base_to_mast" type="prismatic">
    <origin xyz="0 0.025 0.202" rpy="0 0 0" />
    <parent link="base" />
    <child link="mast" />
    <axis xyz="0 0 1" />
    <limit effort="80" velocity="0.12" lower="0" upper="0.1" />
    </joint>
  <joint name="mast_to_panel" type="revolute">
    <origin xyz="0 0 0.224" rpy="0 0 0" />
    <parent link="mast" />
    <child link="panel" />
    <axis xyz="-1 0 0" />
    <limit effort="18" velocity="1.5" lower="-0.18" upper="0.34" />
    </joint>
  <joint name="panel_to_control_wheel" type="continuous">
    <origin xyz="0.222 -0.05 -0.171" rpy="0 0 0" />
    <parent link="panel" />
    <child link="control_wheel" />
    <axis xyz="1 0 0" />
    <limit effort="0.4" velocity="8" />
    </joint>
  </robot>
