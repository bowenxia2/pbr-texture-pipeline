	<link name="control_wheel">
		<inertial>
			<origin xyz="0 0 0" rpy="0 1.5708 0" />
			<mass value="0.03" />
			<inertia ixx="3.1675e-06" ixy="0" ixz="0" iyy="3.1675e-06" iyz="0" izz="1.215e-06" />
