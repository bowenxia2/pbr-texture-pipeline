<?xml version='1.0' encoding='utf-8'?>
<robot name="retro_stainless_air_fryer">
	<material name="stainless">
		<color rgba="0.78 0.8 0.82 1" />
	</material>
	<material name="panel_black">
		<color rgba="0.11 0.11 0.12 1" />
	</material>
	<material name="trim_black">
		<color rgba="0.15 0.15 0.16 1" />
	</material>
	<material name="basket_dark">
		<color rgba="0.17 0.17 0.18 1" />
	</material>
	<material name="knob_black">
		<color rgba="0.1 0.1 0.11 1" />
	</material>
	<material name="latch_red">
		<color rgba="0.82 0.14 0.12 1" />
	</material>
	<link name="body">
		<collision name="housing_shell">
			<geometry>
				<mesh filename="assets/meshes/air_fryer_body_shell.obj" />
			</geometry>
		</collision>
		<collision name="base_band">
