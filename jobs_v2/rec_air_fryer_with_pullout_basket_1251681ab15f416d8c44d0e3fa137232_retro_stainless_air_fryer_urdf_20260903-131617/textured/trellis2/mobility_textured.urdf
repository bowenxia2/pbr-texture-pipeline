			<geometry>
				<mesh filename="assets/meshes/temperature_dial.obj" />
			</geometry>
		</collision>
		<visual name="temperature_dial">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/temperature_dial.glb" />
			</geometry>
		</visual>
	</link>
	<link name="power_rocker">
		<collision name="rocker_paddle">
			<origin xyz="0.003 -0.009 0.02" rpy="0 0 0" />
			<geometry>
				<box size="0.006 0.018 0.04" />
			</geometry>
		</collision>
		<collision name="rocker_hinge">
			<origin xyz="0.0025 0 0.02" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.0025" length="0.04" />
			</geometry>
		</collision>
		<visual name="power_rocker">
			<origin xyz="0 0 0" rpy="0 0 0" />
