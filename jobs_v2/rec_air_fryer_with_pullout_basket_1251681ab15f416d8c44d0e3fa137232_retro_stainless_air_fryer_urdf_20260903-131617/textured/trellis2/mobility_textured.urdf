	<link name="release_latch">
		<collision name="latch_cap">
			<origin xyz="0 0 0.008" rpy="0 0 0" />
			<geometry>
				<box size="0.02 0.018 0.016" />
			</geometry>
		</collision>
		<collision name="latch_thumb">
			<origin xyz="0.003 0 0.019" rpy="0 0 0" />
			<geometry>
				<box size="0.01 0.02 0.006" />
			</geometry>
		</collision>
		<collision name="latch_tongue">
			<origin xyz="0 0 -0.0015" rpy="0 0 0" />
			<geometry>
				<box size="0.012 0.014 0.003" />
