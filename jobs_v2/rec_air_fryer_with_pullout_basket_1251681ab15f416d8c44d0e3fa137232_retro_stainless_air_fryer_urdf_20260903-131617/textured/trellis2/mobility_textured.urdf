	<joint name="body_to_drawer" type="prismatic">
		<origin xyz="0.182 0 0.053" rpy="0 0 0" />
		<parent link="body" />
		<child link="drawer" />
		<axis xyz="1 0 0" />
		<limit effort="80" velocity="0.22" lower="0" upper="0.18" />
	</joint>
	<joint name="body_to_timer_dial" type="continuous">
		<origin xyz="0.186 0 0.314" rpy="0 0 0" />
		<parent link="body" />
		<child link="timer_dial" />
		<axis xyz="1 0 0" />
		<limit effort="0.4" velocity="8" />
	</joint>
	<joint name="body_to_temperature_dial" type="continuous">
		<origin xyz="0.186 0 0.25" rpy="0 0 0" />
		<parent link="body" />
		<child link="temperature_dial" />
		<axis xyz="1 0 0" />
		<limit effort="0.4" velocity="8" />
	</joint>
	<joint name="body_to_power_rocker" type="revolute">
		<origin xyz="0.186 0.099 0.238" rpy="0 0 0" />
		<parent link="body" />
		<child link="power_rocker" />
		<axis xyz="0 0 1" />
		<limit effort="1" velocity="2" lower="-0.18" upper="0.32" />
	</joint>
	<joint name="drawer_to_release_latch" type="prismatic">
		<origin xyz="0.041 0 0.093" rpy="0 0 0" />
		<parent link="drawer" />
		<child link="release_latch" />
		<axis xyz="0 0 1" />
		<limit effort="2" velocity="0.12" lower="0" upper="0.018" />
	</joint>
</robot>