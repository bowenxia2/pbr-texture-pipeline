			<geometry>
				<box size="0.2 0.018 0.03" />
			</geometry>
		</collision>
		<collision name="drawer_guide_1">
			<origin xyz="0.024 0.086 0.038" rpy="0 0 0" />
			<geometry>
				<box size="0.2 0.018 0.03" />
			</geometry>
		</collision>
		<collision>
			<origin xyz="-0.115 -0.105 0.004" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.018" length="0.01" />
			</geometry>
		</collision>
		<collision>
			<origin xyz="-0.115 0.105 0.004" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.018" length="0.01" />
			</geometry>
		</collision>
		<collision>
			<origin xyz="0.115 -0.105 0.004" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.018" length="0.01" />
			</geometry>
		</collision>
		<collision>
			<origin xyz="0.115 0.105 0.004" rpy="0 0 0" />
			<geometry>
				<cylinder radius="0.018" length="0.01" />
			</geometry>
		</collision>
		<visual name="body">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/body.glb" />
			</geometry>
		</visual>
	</link>
	<link name="drawer">
		<collision name="drawer_shell">
			<geometry>
				<mesh filename="assets/meshes/air_fryer_drawer_shell.obj" />
			</geometry>
		</collision>
		<collision name="handle_cover">
			<origin xyz="0.066 0 0.077" rpy="0 0 0" />
			<geometry>
				<box size="0.032 0.108 0.022" />
			</geometry>
		</collision>
		<visual name="drawer">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/drawer.glb" />
			</geometry>
		</visual>
	</link>
	<link name="timer_dial">
		<collision name="timer_knob">
			<origin xyz="0 0 0" rpy="0 1.5708 0" />
			<geometry>
				<mesh filename="assets/meshes/timer_dial.obj" />
			</geometry>
		</collision>
		<visual name="timer_dial">
			<origin xyz="0 0 0" rpy="0 0 0" />
			<geometry>
				<mesh filename="groups/timer_dial.glb" />
			</geometry>
		</visual>
	</link>
	<link name="temperature_dial">
