	<joint name="frame_to_backrest" type="revolute">
		<origin xyz="-0.28 0 0.58" rpy="0 0.42 0" />
		<parent link="main_frame" />
		<child link="backrest" />
		<axis xyz="0 1 0" />
		<limit effort="140" velocity="1" lower="-0.42" upper="0.78" />
	</joint>
	<joint name="frame_to_seat" type="revolute">
